{"items":[{"id":"mi01","name":"手擀面","en":"Hand-Rolled Noodles","cuisine":"中餐","type":"主食","time":50,"level":2,"serves":3,"tags":["面食基础","北方"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":130,"u":"毫升","g":"主料","buy":"water"},{"n":"鸡蛋","q":1,"u":"个","g":"主料","buy":"eggs"},{"n":"盐","q":3,"u":"克","g":"调料","buy":""},{"n":"玉米淀粉（防粘）","q":2,"u":"汤匙","g":"配料","buy":"cornstarch"}],"steps":[{"t":"面粉加盐，鸡蛋打进水里搅匀，分几次倒进面粉，用筷子搅成棉絮状。"},{"t":"揉成很硬的面团（比饺子面硬），盖上醒 20 分钟，再揉一次到表面光滑，再醒 10 分钟。","s":1200},{"t":"案板撒玉米淀粉，用擀面杖把面团擀成 1–2 毫米的大薄片，边擀边撒淀粉防粘。"},{"t":"把面片像折扇一样来回折叠，切成想要的宽度，抓起抖散。"},{"t":"水开下面，煮到浮起再煮 1–2 分钟，捞出拌卤或下汤。","s":150}],"tip":"面要硬，含水量大约是面粉的 45%；越硬越筋道。切好的面撒淀粉分小份冷冻，随吃随煮。","mian":"面条"},{"id":"mi02","name":"油泼扯面","en":"Biang Biang Noodles with Sizzling Oil","cuisine":"中餐","type":"主食","time":90,"level":2,"serves":2,"tags":["陕西","辣","面食"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":160,"u":"毫升","g":"主料","buy":"water"},{"n":"盐","q":3,"u":"克","g":"调料","buy":""},{"n":"食用油","q":5,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"小白菜或菠菜","q":2,"u":"棵","g":"配料","buy":"bok choy"},{"n":"蒜","q":4,"u":"瓣","g":"配料","buy":"garlic"},{"n":"葱","q":2,"u":"根","g":"配料","buy":"green onions"},{"n":"辣椒面","q":2,"u":"汤匙","g":"调料","buy":"Chinese chili flakes"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"香醋","q":2,"u":"汤匙","g":"调料","buy":"black vinegar"}],"steps":[{"t":"面粉加盐和水揉成稍软的面团，醒 15 分钟，再揉光滑。","s":900},{"t":"分成 6 份，搓成长条，表面刷油，盖好醒 1 小时以上（醒得越久越好扯）。","s":3600},{"t":"取一条压扁擀成长舌头形，两手捏住两头，在案板上边摔边拉长，中间撕开成一个圈。"},{"t":"水开下面，同时下青菜，煮 2 分钟。","s":120},{"t":"捞到碗里，放蒜末、葱花、辣椒面，烧一勺滚烫的油泼上去，再淋生抽和醋，拌匀。"}],"tip":"面团一定要刷油醒透，拉的时候才不断。没时间的话擀成宽片切宽条也行。","mian":"面条"},{"id":"mi03","name":"阳春面","en":"Shanghai Scallion Oil Soup Noodles","cuisine":"中餐","type":"主食","time":15,"level":1,"serves":1,"tags":["上海","快手","清淡"],"ing":[{"n":"细面条（鲜面或挂面）","q":120,"u":"克","g":"主料","buy":"thin wheat noodles"},{"n":"葱","q":3,"u":"根","g":"配料","buy":"green onions"},{"n":"猪油或食用油","q":1,"u":"汤匙","g":"调料","buy":"lard"},{"n":"生抽","q":1,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"老抽","q":0.5,"u":"茶匙","g":"调料","buy":"dark soy sauce"},{"n":"白胡椒粉","q":0,"u":"少许","g":"调料","buy":"white pepper"},{"n":"热高汤或开水","q":300,"u":"毫升","g":"主料","buy":"chicken stock"}],"steps":[{"t":"葱白和葱绿分开，葱白切段，葱绿切葱花。"},{"t":"碗里放猪油、生抽、老抽、胡椒粉和一半葱花。"},{"t":"水开下面，按包装时间煮熟。","s":180},{"t":"先冲一大勺滚烫的高汤进碗化开调料，再捞面放进去，撒剩下的葱花。"}],"tip":"猪油是灵魂，美国亚洲超市和墨西哥超市（manteca）都有卖。汤底先放、面后放，面才不坨。","mian":"面条"},{"id":"mi04","name":"武汉热干面","en":"Wuhan Hot Dry Noodles","cuisine":"中餐","type":"主食","time":20,"level":1,"serves":2,"tags":["湖北","芝麻酱","早餐"],"ing":[{"n":"碱水面（粗）","q":250,"u":"克","g":"主料","buy":"alkaline noodles"},{"n":"芝麻酱","q":3,"u":"汤匙","g":"调料","buy":"sesame paste"},{"n":"香油","q":2,"u":"汤匙","g":"调料","buy":"sesame oil"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"榨菜或酸豆角","q":2,"u":"汤匙","g":"配料","buy":"preserved mustard"},{"n":"葱","q":2,"u":"根","g":"配料","buy":"green onions"},{"n":"辣椒油","q":1,"u":"汤匙","g":"调料","buy":"chili oil"}],"steps":[{"t":"芝麻酱加 1 汤匙香油，再一点点加温水（3–4 汤匙）顺一个方向搅，搅到能流动的稀糊。"},{"t":"碱水面下开水煮到八成熟（比包装时间少 1 分钟），捞出。","s":180},{"t":"马上拌 1 汤匙香油，用筷子挑起来抖散、吹凉，这样面不粘。"},{"t":"吃之前把面在开水里烫 10 秒，捞到碗里，加芝麻酱、生抽、榨菜、葱花、辣椒油拌匀。","s":10}],"tip":"亚洲超市冷藏柜有现成的碱水面。没有的话可以用意面加小苏打煮（见面食小课堂）。","mian":"面条"},{"id":"mi05","name":"豉油皇炒面","en":"Cantonese Soy Sauce Pan-Fried Noodles","cuisine":"中餐","type":"主食","time":20,"level":2,"serves":2,"tags":["广东","炒面","茶餐厅"],"ing":[{"n":"广式生面（全蛋细面）","q":200,"u":"克","g":"主料","buy":"Hong Kong style egg noodles"},{"n":"绿豆芽","q":150,"u":"克","g":"配料","buy":"mung bean sprouts"},{"n":"洋葱","q":0.5,"u":"个","g":"配料","buy":"onion"},{"n":"韭黄或葱","q":3,"u":"根","g":"配料","buy":"green onions"},{"n":"生抽","q":1.5,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"老抽","q":1,"u":"汤匙","g":"调料","buy":"dark soy sauce"},{"n":"糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},{"n":"食用油","q":3,"u":"汤匙","g":"调料","buy":"vegetable oil"}],"steps":[{"t":"面在开水里烫 1 分钟就捞出，过冷水，沥得越干越好，拌一点油抖散。","s":60},{"t":"生抽、老抽、糖和 1 汤匙水调成酱汁。"},{"t":"锅烧到冒烟，下油，把面摊平，中火煎到底部金黄再翻面，两面都煎香。","s":240},{"t":"拨到一边，下洋葱丝、豆芽大火炒几下。"},{"t":"沿锅边淋入酱汁，用筷子把面和菜挑散炒匀，最后放韭黄或葱段，炒 10 秒出锅。"}],"tip":"炒面要用筷子挑着炒，不要用铲子压；锅要够热，面才干身不粘。","mian":"面条"},{"id":"mi06","name":"洗面筋凉皮","en":"Liangpi Cold Skin Noodles","cuisine":"中餐","type":"凉菜","time":120,"level":3,"serves":3,"tags":["陕西","夏天","面筋"],"ing":[{"n":"中筋面粉","q":500,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水（和面）","q":270,"u":"毫升","g":"主料","buy":"water"},{"n":"盐","q":3,"u":"克","g":"调料","buy":""},{"n":"黄瓜","q":1,"u":"根","g":"配料","buy":"cucumber"},{"n":"蒜","q":4,"u":"瓣","g":"调料","buy":"garlic"},{"n":"辣椒油","q":3,"u":"汤匙","g":"调料","buy":"chili oil"},{"n":"香醋","q":3,"u":"汤匙","g":"调料","buy":"black vinegar"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"芝麻酱","q":1,"u":"汤匙","g":"调料","buy":"sesame paste"},{"n":"即发干酵母（发面筋用）","q":0.5,"u":"茶匙","g":"配料","buy":"instant yeast"}],"steps":[{"t":"面粉加盐和水揉成光滑面团，盖好醒 30 分钟。","s":1800},{"t":"盆里加清水没过面团，反复揉洗，水变成白浆就倒到另一个盆里，再加清水洗，直到剩下一团面筋、水基本清。"},{"t":"面浆静置 4 小时或冷藏过夜，倒掉上层清水，把下层浆搅匀成酸奶般的稀糊。","s":14400},{"t":"面筋揉进一点酵母，醒 30 分钟后蒸 25 分钟，晾凉切块。","s":1500},{"t":"平底盘刷油，舀一勺面浆摇匀成薄薄一层，放进开水锅里盖盖蒸 2 分钟，起大泡就熟。","s":120},{"t":"连盘放进冷水降温，揭下凉皮刷油叠放。全部蒸完切条，加黄瓜丝、面筋，浇蒜水、辣椒油、醋、生抽、芝麻酱拌匀。"}],"tip":"关键是面浆沉淀后要把上面的清水倒干净，浆太稀蒸不起来。蒸盘可以用不粘的圆蛋糕模。","mian":"面条"},{"id":"mi07","name":"番茄疙瘩汤","en":"Tomato and Egg Flour Dumpling Soup","cuisine":"中餐","type":"汤","time":20,"level":1,"serves":2,"tags":["北方","暖胃","快手"],"ing":[{"n":"中筋面粉","q":100,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"番茄","q":2,"u":"个","g":"配料","buy":"tomatoes"},{"n":"鸡蛋","q":1,"u":"个","g":"配料","buy":"eggs"},{"n":"葱","q":1,"u":"根","g":"配料","buy":"green onions"},{"n":"小青菜","q":1,"u":"小把","g":"配料","buy":"baby bok choy"},{"n":"食用油","q":1,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""},{"n":"香油","q":1,"u":"茶匙","g":"调料","buy":"sesame oil"}],"steps":[{"t":"面粉放大碗里，水龙头开到最小一滴一滴往下滴，边滴边用筷子搅，搅成米粒大小的面疙瘩。"},{"t":"锅里放油，炒葱花和番茄块，炒出红汤。","s":120},{"t":"加 600 毫升水烧开，一边搅一边撒入面疙瘩，煮 3 分钟。","s":180},{"t":"淋入打散的鸡蛋，放青菜，加盐，滴香油出锅。","s":30}],"tip":"疙瘩越小越好吃，诀窍是水要「滴」不要「倒」；剩下的干粉筛掉不要。","mian":"面条"},{"id":"mi08","name":"酸汤揪面片","en":"Hand-Torn Noodle Pieces in Sour Soup","cuisine":"中餐","type":"主食","time":45,"level":2,"serves":2,"tags":["西北","面片","暖胃"],"ing":[{"n":"中筋面粉","q":250,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":125,"u":"毫升","g":"主料","buy":"water"},{"n":"盐","q":2,"u":"克","g":"调料","buy":""},{"n":"牛肉或羊肉片","q":150,"u":"克","g":"配料","buy":"thinly sliced beef"},{"n":"番茄","q":1,"u":"个","g":"配料","buy":"tomato"},{"n":"青椒","q":1,"u":"个","g":"配料","buy":"green bell pepper"},{"n":"香醋","q":2,"u":"汤匙","g":"调料","buy":"black vinegar"},{"n":"生抽","q":1,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"}],"steps":[{"t":"面粉加盐和水揉成面团，搓成手指粗的长条，刷油盖好醒 30 分钟。","s":1800},{"t":"锅里放油炒肉片、番茄、青椒，加生抽，倒 800 毫升水烧开。","s":300},{"t":"把面条压扁拉长，左手拿面，右手拇指和食指把面揪成拇指大小的片，直接揪进开水锅里。"},{"t":"揪完再煮 2 分钟，加醋和盐调味。","s":120}],"tip":"新疆叫揪片子，陕甘叫面片。面要醒软，揪的时候才薄。","mian":"面条"},{"id":"mi09","name":"手工鸡蛋意面","en":"Fresh Egg Pasta","cuisine":"西餐","type":"主食","time":60,"level":2,"serves":4,"tags":["意大利","面食基础"],"ing":[{"n":"00 号面粉或中筋面粉","q":300,"u":"克","g":"主料","buy":"00 flour or all-purpose flour"},{"n":"鸡蛋","q":3,"u":"个","g":"主料","buy":"large eggs"},{"n":"橄榄油","q":1,"u":"茶匙","g":"调料","buy":"olive oil"},{"n":"盐","q":0,"u":"少许","g":"调料","buy":""}],"steps":[{"t":"面粉在案板上堆成小山，中间挖一个洞，打入鸡蛋和橄榄油。"},{"t":"用叉子从中间慢慢把面粉搅进蛋液，成团后用手揉 8–10 分钟，到表面光滑有弹性。","s":600},{"t":"保鲜膜包好醒 30 分钟。","s":1800},{"t":"分成 4 份，擀到能隐约透光（约 1 毫米），撒粉卷起，切成宽面（tagliatelle）或细面。"},{"t":"加盐的开水煮 2–3 分钟就熟，比干意面快很多。","s":150}],"tip":"面团太干就手沾点水揉，太湿就撒面粉。有压面机会轻松很多。","mian":"意面"},{"id":"mi10","name":"番茄肉丸意面","en":"Spaghetti and Meatballs","cuisine":"西餐","type":"主食","time":60,"level":2,"serves":4,"tags":["美式意大利","家庭"],"ing":[{"n":"意大利细面","q":400,"u":"克","g":"主料","buy":"spaghetti"},{"n":"牛肉末","q":450,"u":"克","g":"主料","buy":"ground beef"},{"n":"面包糠","q":0.5,"u":"杯","g":"配料","buy":"breadcrumbs"},{"n":"牛奶","q":60,"u":"毫升","g":"配料","buy":"milk"},{"n":"鸡蛋","q":1,"u":"个","g":"配料","buy":"eggs"},{"n":"帕玛森奶酪碎","q":0.5,"u":"杯","g":"配料","buy":"grated parmesan"},{"n":"蒜","q":4,"u":"瓣","g":"调料","buy":"garlic"},{"n":"番茄碎罐头","q":1,"u":"罐","g":"主料","buy":"crushed tomatoes (28 oz)"},{"n":"橄榄油","q":2,"u":"汤匙","g":"调料","buy":"olive oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"面包糠泡牛奶 5 分钟，加牛肉末、鸡蛋、一半奶酪、2 瓣蒜末、盐和胡椒，轻轻拌匀，团成高尔夫球大小。"},{"t":"锅里放橄榄油，中火把肉丸煎到四面焦黄（不用熟透），盛出。","s":480},{"t":"同一个锅炒剩下的蒜末，倒番茄碎，加盐，小火煮 10 分钟。","s":600},{"t":"肉丸放回酱里，盖盖小火煮 15 分钟。","s":900},{"t":"意面在加盐的开水里煮到 al dente（比包装少 1 分钟），捞到酱里拌匀，撒奶酪。","s":540}],"tip":"拌肉馅别用力搅，肉丸才嫩。煮面水要咸得像海水。","mian":"意面"},{"id":"mi11","name":"蒜香白酒虾意面","en":"Shrimp Scampi Linguine","cuisine":"西餐","type":"主食","time":25,"level":1,"serves":2,"tags":["意大利","海鲜","快手"],"ing":[{"n":"扁意面 linguine","q":200,"u":"克","g":"主料","buy":"linguine"},{"n":"大虾（去壳）","q":250,"u":"克","g":"主料","buy":"large shrimp"},{"n":"蒜","q":5,"u":"瓣","g":"调料","buy":"garlic"},{"n":"黄油","q":3,"u":"汤匙","g":"调料","buy":"butter"},{"n":"干白葡萄酒或鸡汤","q":120,"u":"毫升","g":"调料","buy":"dry white wine"},{"n":"柠檬","q":0.5,"u":"个","g":"调料","buy":"lemon"},{"n":"欧芹","q":1,"u":"小把","g":"配料","buy":"parsley"},{"n":"辣椒碎","q":0,"u":"少许","g":"调料","buy":"red pepper flakes"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"意面下加盐的开水煮，留一杯煮面水。","s":540},{"t":"同时锅里化 1 汤匙黄油，虾两面各煎 1 分钟，盛出。","s":120},{"t":"下剩下的黄油、蒜片、辣椒碎，小火炒香，倒白酒煮 2 分钟。","s":120},{"t":"放入意面、虾、柠檬汁，加几勺煮面水翻拌到酱汁裹住面，撒欧芹。"}],"tip":"虾一变色就盛出，最后再回锅，才不会老。","mian":"意面"},{"id":"mi12","name":"黑胡椒奶酪意面","en":"Cacio e Pepe","cuisine":"西餐","type":"主食","time":20,"level":2,"serves":2,"tags":["罗马","极简"],"ing":[{"n":"意大利粗面或细面","q":200,"u":"克","g":"主料","buy":"spaghetti or tonnarelli"},{"n":"佩科里诺羊奶酪（磨细）","q":80,"u":"克","g":"主料","buy":"Pecorino Romano"},{"n":"黑胡椒（现磨粗粒）","q":2,"u":"茶匙","g":"调料","buy":"black peppercorns"},{"n":"黄油","q":1,"u":"汤匙","g":"调料","buy":"butter"}],"steps":[{"t":"用比平时少的水煮面（煮面水要浓、要有淀粉），盐少放，奶酪本身很咸。","s":480},{"t":"黑胡椒在干锅里烤香，加两勺煮面水煮开。"},{"t":"奶酪碎加少量温（不烫）的煮面水搅成糊。"},{"t":"意面捞进胡椒锅，加黄油，关火稍凉 30 秒，再倒入奶酪糊快速翻拌，酱汁不够就加煮面水。","s":30}],"tip":"只有三样东西，难在不结块：奶酪要磨得很细，下奶酪时锅不能太烫。","mian":"意面"},{"id":"mi13","name":"韭菜鸡蛋饺子（含擀皮）","en":"Chive and Egg Dumplings from Scratch","cuisine":"中餐","type":"主食","time":90,"level":2,"serves":4,"tags":["北方","素馅","面食基础"],"ing":[{"n":"中筋面粉","q":400,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":200,"u":"毫升","g":"主料","buy":"water"},{"n":"韭菜","q":300,"u":"克","g":"主料","buy":"Chinese chives"},{"n":"鸡蛋","q":4,"u":"个","g":"主料","buy":"eggs"},{"n":"虾皮（可选）","q":2,"u":"汤匙","g":"配料","buy":"dried shrimp"},{"n":"香油","q":2,"u":"汤匙","g":"调料","buy":"sesame oil"},{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"面粉慢慢加水，搅成絮状后揉成团，醒 20 分钟再揉光滑，醒 10 分钟。","s":1200},{"t":"鸡蛋炒成碎块晾凉；韭菜洗净控干切碎，先拌香油锁住水，再加鸡蛋、虾皮，包之前才放盐。"},{"t":"面团搓长条，切成小剂子（约 10 克一个），按扁，用擀面杖擀成中间厚边上薄的圆皮。"},{"t":"放馅，对折捏紧中间，再从两边往中间捏褶。"},{"t":"水开下饺子，推一推防粘，煮开后加半碗冷水，重复两次，饺子鼓起来就熟。","s":480}],"tip":"韭菜馅一放盐就出水，要包之前才放。擀皮时左手转、右手擀，边薄中间厚，煮的时候才不破。","mian":"饺子馄饨"},{"id":"mi14","name":"冰花锅贴","en":"Crispy Lattice Potstickers","cuisine":"中餐","type":"小吃","time":30,"level":2,"serves":3,"tags":["锅贴","煎饺"],"ing":[{"n":"饺子（生，自包或冷冻）","q":20,"u":"个","g":"主料","buy":"frozen dumplings"},{"n":"面粉","q":1,"u":"汤匙","g":"调料","buy":"all-purpose flour"},{"n":"水","q":150,"u":"毫升","g":"调料","buy":"water"},{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"葱花、黑芝麻","q":0,"u":"少许","g":"配料","buy":""}],"steps":[{"t":"面粉加水调成稀稀的面粉水。"},{"t":"平底不粘锅放油，饺子排好，中火煎 2 分钟到底部微黄。","s":120},{"t":"倒入面粉水到饺子三分之一高，盖盖中火焖 8 分钟（冷冻饺子 10 分钟）。","s":480},{"t":"开盖让剩下的水分烧干，底部结出一层网状脆底，撒葱花芝麻。","s":120},{"t":"盘子扣在锅上，一起翻过来，脆底朝上出锅。"}],"tip":"冷冻饺子不用解冻直接煎。面粉水比例大约 1:10，太浓冰花会厚。","mian":"饺子馄饨"},{"id":"mi15","name":"红油抄手","en":"Sichuan Wontons in Chili Oil","cuisine":"中餐","type":"小吃","time":40,"level":2,"serves":3,"tags":["四川","辣","馄饨"],"ing":[{"n":"馄饨皮","q":30,"u":"张","g":"主料","buy":"wonton wrappers"},{"n":"猪肉末","q":250,"u":"克","g":"主料","buy":"ground pork"},{"n":"姜","q":1,"u":"小块","g":"调料","buy":"ginger"},{"n":"葱","q":2,"u":"根","g":"调料","buy":"green onions"},{"n":"红油辣子","q":3,"u":"汤匙","g":"调料","buy":"chili oil"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"香醋","q":1,"u":"汤匙","g":"调料","buy":"black vinegar"},{"n":"糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},{"n":"蒜","q":3,"u":"瓣","g":"调料","buy":"garlic"},{"n":"花椒粉","q":0,"u":"少许","g":"调料","buy":"Sichuan peppercorn powder"}],"steps":[{"t":"姜葱泡水，肉末分几次加入姜葱水顺一个方向搅到上劲，加盐和 1 汤匙生抽。"},{"t":"馄饨皮放一小团馅，对折成三角，再把两个角往中间捏在一起，成「抄手」形。"},{"t":"碗里放蒜泥、红油、生抽、醋、糖、花椒粉。"},{"t":"水开下抄手，煮到浮起再煮 1 分钟，捞进碗里拌匀。","s":240}],"tip":"红油辣子可以自己泼：辣椒面加芝麻，浇上烧到冒烟再晾 1 分钟的热油。","mian":"饺子馄饨"},{"id":"mi16","name":"糯米烧卖","en":"Sticky Rice Shumai","cuisine":"中餐","type":"早餐","time":60,"level":2,"serves":4,"tags":["早点","糯米"],"ing":[{"n":"饺子皮或烧卖皮","q":24,"u":"张","g":"主料","buy":"dumpling wrappers"},{"n":"糯米","q":300,"u":"克","g":"主料","buy":"glutinous rice"},{"n":"猪肉末","q":150,"u":"克","g":"配料","buy":"ground pork"},{"n":"香菇","q":4,"u":"朵","g":"配料","buy":"dried shiitake"},{"n":"老抽","q":1,"u":"汤匙","g":"调料","buy":"dark soy sauce"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"}],"steps":[{"t":"糯米提前泡 4 小时，铺纱布蒸 30 分钟。","s":1800},{"t":"锅里放油炒肉末和香菇丁，加生抽、老抽、少许糖和泡香菇的水，倒入糯米饭拌匀收汁。","s":300},{"t":"饺子皮边缘擀出荷叶边。"},{"t":"放一大勺糯米馅，虎口收拢，口不用封，像个小花瓶。"},{"t":"开水上锅蒸 10 分钟。","s":600}],"tip":"饺子皮擀薄后用擀面杖只压边缘，就能擀出花边。","mian":"饺子馄饨"},{"id":"mi17","name":"豆沙包","en":"Red Bean Paste Steamed Buns","cuisine":"中餐","type":"早餐","time":120,"level":2,"serves":8,"tags":["发面","甜"],"ing":[{"n":"中筋面粉","q":400,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":210,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"糖","q":2,"u":"汤匙","g":"调料","buy":"sugar"},{"n":"红豆沙","q":400,"u":"克","g":"主料","buy":"red bean paste"}],"steps":[{"t":"酵母和糖化在温水里，倒进面粉揉成光滑面团，盖好放温暖处发酵到两倍大（约 1 小时，戳个洞不回缩）。","s":3600},{"t":"排气揉 5 分钟，到切开没有大气孔，分成 8 份。","s":300},{"t":"豆沙团成 8 个球，面皮擀圆包入，收口朝下，搓圆。"},{"t":"放蒸笼里再醒 20 分钟，变大变轻。","s":1200},{"t":"冷水上锅，水开后中火蒸 15 分钟，关火焖 3 分钟再开盖。","s":900}],"tip":"关火后别马上开盖，不然包子会塌皮。冬天发面可以放进开着灯的烤箱里。","mian":"包子馒头"},{"id":"mi18","name":"水煎包","en":"Pan-Fried Pork Buns","cuisine":"中餐","type":"早餐","time":120,"level":2,"serves":4,"tags":["发面","煎","山东"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":160,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"猪肉末","q":300,"u":"克","g":"主料","buy":"ground pork"},{"n":"大葱","q":1,"u":"根","g":"配料","buy":"leek or green onions"},{"n":"姜","q":1,"u":"小块","g":"调料","buy":"ginger"},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"面粉水","q":150,"u":"毫升","g":"调料","buy":""},{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"黑芝麻、葱花","q":0,"u":"少许","g":"配料","buy":""}],"steps":[{"t":"酵母化在温水里和面，发酵到两倍大。","s":3600},{"t":"肉末加姜葱水、生抽、盐搅上劲，拌葱花。"},{"t":"面团排气分成小剂子，擀皮包成小包子，醒 15 分钟。","s":900},{"t":"平底锅放油排好包子，中火煎 2 分钟，倒面粉水到包子三分之一高，盖盖焖 10 分钟。","s":720},{"t":"开盖烧干水，撒芝麻葱花，底部金黄酥脆出锅。","s":90}],"tip":"做法和冰花锅贴一样，只是换成发面包子。","mian":"包子馒头"},{"id":"mi19","name":"小笼汤包","en":"Xiaolongbao Soup Dumplings","cuisine":"中餐","type":"小吃","time":240,"level":3,"serves":4,"tags":["上海","有挑战","汤汁"],"ing":[{"n":"中筋面粉","q":200,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":100,"u":"毫升","g":"主料","buy":"water"},{"n":"猪皮","q":200,"u":"克","g":"主料","buy":"pork skin"},{"n":"猪肉末（三肥七瘦）","q":250,"u":"克","g":"主料","buy":"ground pork"},{"n":"姜","q":1,"u":"块","g":"调料","buy":"ginger"},{"n":"葱","q":2,"u":"根","g":"调料","buy":"green onions"},{"n":"生抽","q":1,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"料酒","q":1,"u":"汤匙","g":"调料","buy":"Shaoxing wine"},{"n":"糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},{"n":"姜丝、香醋（蘸料）","q":0,"u":"适量","g":"调料","buy":"black vinegar"}],"steps":[{"t":"做皮冻：猪皮焯水去油刮净切小条，加 5 倍水、姜葱、料酒小火煮 2 小时，过滤冷藏凝固。","s":7200},{"t":"肉末加姜葱水、生抽、糖、盐搅上劲，皮冻切碎拌进去（皮冻和肉差不多一样多），冷藏。"},{"t":"面粉加水揉成光滑的硬面团（冷水面），醒 30 分钟。","s":1800},{"t":"分成 8 克一个的小剂子，擀成很薄的圆皮，包馅捏出 18 个左右的褶。"},{"t":"蒸笼铺纸或白菜叶，大火蒸 7–8 分钟。配姜丝香醋，先咬小口吸汤。","s":450}],"tip":"汤汁全靠皮冻，皮冻一定要冷透才好包。偷懒可以用无味吉利丁加鸡汤做冻。","mian":"包子馒头"},{"id":"mi20","name":"肉夹馍","en":"Roujiamo (Chinese Pork Burger)","cuisine":"中餐","type":"主食","time":180,"level":2,"serves":6,"tags":["陕西","发面饼","卤肉"],"ing":[{"n":"中筋面粉","q":400,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":220,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"五花肉","q":600,"u":"克","g":"主料","buy":"pork belly"},{"n":"冰糖","q":20,"u":"克","g":"调料","buy":"rock sugar"},{"n":"生抽","q":3,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"老抽","q":1,"u":"汤匙","g":"调料","buy":"dark soy sauce"},{"n":"八角、桂皮、香叶、花椒","q":0,"u":"适量","g":"调料","buy":"star anise, cinnamon, bay leaves"},{"n":"青椒、香菜","q":0,"u":"适量","g":"配料","buy":"green pepper, cilantro"}],"steps":[{"t":"五花肉切大块焯水，锅里放冰糖炒出糖色，下肉翻炒上色。"},{"t":"加生抽、老抽、香料和没过肉的热水，小火炖 2 小时到软烂。","s":7200},{"t":"面粉加酵母、温水和少许油，揉成面团，发酵 40 分钟。","s":2400},{"t":"面团分 6 份，搓长条卷成圆柱，竖起来按扁成饼（会形成「铁圈虎背菊花心」）。"},{"t":"平底锅不放油，小火烙到两面有黄色圈，再放进 200°C 烤箱烤 5 分钟，饼边鼓起。","s":600},{"t":"饼从侧面切开，夹进剁碎的卤肉（加青椒、香菜），浇一勺卤汁。"}],"tip":"卤肉一次多做，分装冷冻，饼也可以冻，早上烤一下就是早餐。","mian":"饼"},{"id":"mi21","name":"韭菜盒子","en":"Chive Pockets","cuisine":"中餐","type":"小吃","time":60,"level":2,"serves":4,"tags":["北方","烫面","煎"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"开水","q":100,"u":"毫升","g":"主料","buy":"boiling water"},{"n":"冷水","q":70,"u":"毫升","g":"主料","buy":"water"},{"n":"韭菜","q":300,"u":"克","g":"主料","buy":"Chinese chives"},{"n":"鸡蛋","q":3,"u":"个","g":"主料","buy":"eggs"},{"n":"粉丝","q":1,"u":"小把","g":"配料","buy":"glass noodles"},{"n":"虾皮","q":2,"u":"汤匙","g":"配料","buy":"dried shrimp"},{"n":"香油","q":2,"u":"汤匙","g":"调料","buy":"sesame oil"},{"n":"食用油","q":3,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"面粉先倒开水搅成絮，再倒冷水，揉成软面团，醒 30 分钟（半烫面，皮软不硬）。","s":1800},{"t":"鸡蛋炒碎，粉丝泡软剪碎，韭菜切碎拌香油，混合虾皮，包之前放盐。"},{"t":"面团分 8 份，擀成圆饼，一半放馅，对折，边缘压紧再捏出花边。"},{"t":"平底锅少油，中小火煎到两面金黄，馅里能听见滋滋声。","s":480}],"tip":"用烫面，凉了也软。馅要包之前才放盐。","mian":"饼"},{"id":"mi22","name":"牛肉馅饼","en":"Pan-Fried Beef Pies","cuisine":"中餐","type":"主食","time":60,"level":2,"serves":4,"tags":["北方","馅饼"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":190,"u":"毫升","g":"主料","buy":"warm water"},{"n":"牛肉末","q":300,"u":"克","g":"主料","buy":"ground beef"},{"n":"洋葱","q":1,"u":"个","g":"配料","buy":"onion"},{"n":"姜","q":1,"u":"小块","g":"调料","buy":"ginger"},{"n":"花椒水","q":60,"u":"毫升","g":"调料","buy":""},{"n":"生抽","q":2,"u":"汤匙","g":"调料","buy":"light soy sauce"},{"n":"五香粉","q":1,"u":"茶匙","g":"调料","buy":"five-spice powder"},{"n":"食用油","q":3,"u":"汤匙","g":"调料","buy":"vegetable oil"}],"steps":[{"t":"面粉加温水和成很软的面团（软到粘手），抹油醒 30 分钟。","s":1800},{"t":"牛肉末分次加花椒水搅上劲，加生抽、五香粉、姜末，最后拌入洋葱碎和 1 汤匙油。"},{"t":"手上抹油，取一块面团按扁，放一大团馅，像包包子一样收口，收口朝下轻轻按成饼。"},{"t":"平底锅放油，中小火盖盖煎 4 分钟，翻面再煎 4 分钟，两面金黄鼓起。","s":480}],"tip":"面越软馅饼越薄越好吃，手上和案板多抹油就不粘。","mian":"饼"},{"id":"mi23","name":"千层发面饼","en":"Layered Scallion Flatbread","cuisine":"中餐","type":"主食","time":90,"level":2,"serves":4,"tags":["北方","发面","葱香"],"ing":[{"n":"中筋面粉","q":400,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":230,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"葱","q":4,"u":"根","g":"配料","buy":"green onions"},{"n":"五香粉","q":1,"u":"茶匙","g":"调料","buy":"five-spice powder"},{"n":"食用油","q":4,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"面粉加酵母温水揉成软面团，发酵到 1.5 倍大。","s":2700},{"t":"油里加 2 汤匙面粉、五香粉和盐调成油酥。"},{"t":"面团擀成大长方形，抹油酥撒葱花，从长边卷起，两头捏紧，盘成蜗牛形，按扁擀成饼，醒 15 分钟。","s":900},{"t":"平底锅少油，小火盖盖烙，5 分钟翻一次，两面金黄、按上去有弹性就熟。","s":900}],"tip":"火要小，饼厚，急火外面焦了里面还生。","mian":"饼"},{"id":"mi24","name":"春饼（烫面薄饼）","en":"Spring Pancakes (Mandarin Pancakes)","cuisine":"中餐","type":"主食","time":50,"level":2,"serves":4,"tags":["北方","烫面","卷菜"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"开水","q":200,"u":"毫升","g":"主料","buy":"boiling water"},{"n":"香油","q":2,"u":"汤匙","g":"调料","buy":"sesame oil"},{"n":"土豆丝、豆芽、韭菜、炒鸡蛋、京酱肉丝","q":0,"u":"适量","g":"配料","buy":"fillings"}],"steps":[{"t":"开水倒进面粉，用筷子搅成絮，稍凉后揉成软面团，醒 20 分钟。","s":1200},{"t":"搓长条切小剂子，按扁，两个一组：中间刷香油、撒薄粉，叠在一起擀成很薄的大圆饼。"},{"t":"平底锅不放油，中火烙 30 秒，起泡就翻，鼓起来马上出锅。","s":60},{"t":"趁热从边上撕开，一张变两张，盖湿布保温。卷上各种炒菜吃。"}],"tip":"两张叠一起擀再撕开，饼才能薄得透光。北京烤鸭的饼也是这么做的。","mian":"饼"},{"id":"mi25","name":"煎饼果子","en":"Jianbing (Tianjin Crepe)","cuisine":"中餐","type":"早餐","time":25,"level":2,"serves":2,"tags":["天津","街头","早餐"],"ing":[{"n":"绿豆面","q":60,"u":"克","g":"主料","buy":"mung bean flour"},{"n":"中筋面粉","q":40,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"水","q":180,"u":"毫升","g":"主料","buy":"water"},{"n":"鸡蛋","q":2,"u":"个","g":"主料","buy":"eggs"},{"n":"薄脆或油条","q":2,"u":"片","g":"配料","buy":"fried wonton crackers"},{"n":"甜面酱","q":2,"u":"汤匙","g":"调料","buy":"sweet bean sauce"},{"n":"辣酱","q":1,"u":"汤匙","g":"调料","buy":"chili sauce"},{"n":"葱花、香菜、黑芝麻","q":0,"u":"适量","g":"配料","buy":""}],"steps":[{"t":"绿豆面、面粉加水调成能流动的稀糊，静置 10 分钟。","s":600},{"t":"大平底锅擦薄油，中小火，倒一勺面糊，用铲子或锅底快速摊成大薄饼。"},{"t":"面糊一凝固就打一个鸡蛋，抹开，撒葱花、香菜、芝麻。","s":60},{"t":"翻面，刷甜面酱和辣酱，放薄脆，四边折起来，对折出锅。"}],"tip":"没有绿豆面全用中筋面粉也行。薄脆可以用馄饨皮炸，或者用薯片、生菜代替。","mian":"饼"},{"id":"mi26","name":"鸡蛋软饼","en":"Soft Egg and Scallion Pancakes","cuisine":"中餐","type":"早餐","time":15,"level":1,"serves":2,"tags":["快手","面糊"],"ing":[{"n":"中筋面粉","q":100,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"鸡蛋","q":2,"u":"个","g":"主料","buy":"eggs"},{"n":"水","q":150,"u":"毫升","g":"主料","buy":"water"},{"n":"葱","q":2,"u":"根","g":"配料","buy":"green onions"},{"n":"食用油","q":1,"u":"汤匙","g":"调料","buy":"vegetable oil"},{"n":"盐","q":0,"u":"适量","g":"调料","buy":""}],"steps":[{"t":"面粉、鸡蛋、水、盐搅成没有颗粒的稀面糊，放葱花。"},{"t":"平底锅刷薄油，倒一勺面糊转锅摊开。"},{"t":"中小火煎到表面凝固、底部微黄，翻面再煎 30 秒。","s":120}],"tip":"面糊稀到像酸奶就对了。可以加西葫芦丝、胡萝卜丝。","mian":"饼"},{"id":"mi27","name":"墨西哥面粉饼","en":"Homemade Flour Tortillas","cuisine":"西餐","type":"主食","time":45,"level":2,"serves":8,"tags":["墨西哥","面食基础"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"猪油或黄油","q":60,"u":"克","g":"主料","buy":"lard or butter"},{"n":"温水","q":180,"u":"毫升","g":"主料","buy":"warm water"},{"n":"泡打粉","q":1,"u":"茶匙","g":"调料","buy":"baking powder"},{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"salt"}],"steps":[{"t":"面粉、泡打粉、盐混合，加猪油用手搓成粗沙状。"},{"t":"倒温水揉成柔软光滑的面团，分成 8 份搓圆，盖好醒 20 分钟。","s":1200},{"t":"每个擀成直径约 20 厘米的薄圆饼。"},{"t":"干锅中大火，每面烙 30–45 秒，起大泡、有焦点就翻。","s":90},{"t":"烙好的饼叠在干净的布里保温保湿。"}],"tip":"比超市的软很多。可以做塔可、quesadilla、早餐卷饼。","mian":"饼"},{"id":"mi28","name":"免揉乡村面包","en":"No-Knead Crusty Bread","cuisine":"西餐","type":"主食","time":960,"level":1,"serves":8,"tags":["面包入门","铸铁锅","免揉"],"ing":[{"n":"高筋面粉","q":430,"u":"克","g":"主料","buy":"bread flour"},{"n":"水","q":345,"u":"毫升","g":"主料","buy":"water"},{"n":"盐","q":8,"u":"克","g":"调料","buy":"salt"},{"n":"即发干酵母","q":0.25,"u":"茶匙","g":"主料","buy":"instant yeast"}],"steps":[{"t":"所有材料放进大碗，用勺子搅到没有干粉（湿黏是对的），盖好室温放 12–18 小时，表面满是气泡。","s":43200},{"t":"倒在撒粉的案板上，四边往中间折几下，整成圆团，放在撒粉的布或烘焙纸上再发 1–2 小时。","s":5400},{"t":"同时把带盖的铸铁锅放进烤箱，预热到 230°C（450°F）30 分钟。","s":1800},{"t":"面团连纸放进烫锅，盖盖烤 30 分钟。","s":1800},{"t":"开盖再烤 15 分钟到深金棕色。出炉放凉 1 小时再切。","s":900}],"tip":"几乎不用技术，靠时间和铸铁锅。敲面包底有空洞声就熟了。","mian":"面包"},{"id":"mi29","name":"白吐司","en":"Classic White Sandwich Bread","cuisine":"西餐","type":"早餐","time":210,"level":2,"serves":10,"tags":["吐司","面包"],"ing":[{"n":"高筋面粉","q":400,"u":"克","g":"主料","buy":"bread flour"},{"n":"牛奶","q":240,"u":"毫升","g":"主料","buy":"milk"},{"n":"糖","q":30,"u":"克","g":"调料","buy":"sugar"},{"n":"即发干酵母","q":2,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"黄油（软化）","q":30,"u":"克","g":"主料","buy":"butter"},{"n":"盐","q":6,"u":"克","g":"调料","buy":"salt"}],"steps":[{"t":"面粉、糖、酵母、盐、温牛奶混合揉成团，揉 10 分钟后加黄油，再揉 10 分钟，到能拉出薄膜。","s":1200},{"t":"盖好发酵到两倍大，约 1 小时。","s":3600},{"t":"排气分成 3 份，分别擀长卷起，并排放进 9×5 英寸吐司模。"},{"t":"再发酵到面团高出模具边缘约 1 厘米，约 45 分钟。","s":2700},{"t":"烤箱 180°C（350°F）烤 35 分钟，表面金黄，出炉马上脱模放凉。","s":2100}],"tip":"揉面是关键，能拉出透光薄膜才算到位；有厨师机会省力很多。","mian":"面包"},{"id":"mi30","name":"晚餐小软包","en":"Soft Dinner Rolls","cuisine":"西餐","type":"主食","time":150,"level":1,"serves":12,"tags":["感恩节","面包"],"ing":[{"n":"中筋面粉","q":450,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"牛奶","q":240,"u":"毫升","g":"主料","buy":"milk"},{"n":"鸡蛋","q":1,"u":"个","g":"主料","buy":"eggs"},{"n":"黄油","q":60,"u":"克","g":"主料","buy":"butter"},{"n":"糖","q":40,"u":"克","g":"调料","buy":"sugar"},{"n":"即发干酵母","q":2,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"salt"}],"steps":[{"t":"牛奶和黄油加热到温（不烫手），加糖、酵母、鸡蛋，倒进面粉和盐里揉成软面团，揉 8 分钟。","s":480},{"t":"发酵到两倍大，约 1 小时。","s":3600},{"t":"分成 12 份搓圆，排在 9×13 英寸烤盘里，再发 40 分钟。","s":2400},{"t":"190°C（375°F）烤 20 分钟，出炉刷化黄油。","s":1200}],"tip":"感恩节、圣诞节饭桌必备。可以提前一天整形好冷藏，第二天回温直接烤。","mian":"面包"},{"id":"mi31","name":"纽约贝果","en":"New York Style Bagels","cuisine":"西餐","type":"早餐","time":150,"level":2,"serves":8,"tags":["纽约","嚼劲"],"ing":[{"n":"高筋面粉","q":500,"u":"克","g":"主料","buy":"bread flour"},{"n":"温水","q":300,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":2,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"糖或蜂蜜","q":1,"u":"汤匙","g":"调料","buy":"sugar or honey"},{"n":"盐","q":10,"u":"克","g":"调料","buy":"salt"},{"n":"小苏打（煮水用）","q":1,"u":"汤匙","g":"调料","buy":"baking soda"},{"n":"芝麻或综合调味粉","q":0,"u":"适量","g":"配料","buy":"everything bagel seasoning"}],"steps":[{"t":"所有材料揉成很硬的面团，揉 10 分钟，发酵 1 小时。","s":3600},{"t":"分 8 份搓成球，手指从中间戳洞撑大成圈（洞要比想象的大），醒 20 分钟。","s":1200},{"t":"一大锅水加糖和小苏打烧开，贝果每面煮 1 分钟，捞出沾芝麻。","s":120},{"t":"220°C（425°F）烤 20 分钟到深金黄。","s":1200}],"tip":"先煮后烤，才有亮亮的硬皮和紧实的嚼劲。冷藏发酵一夜味道更好。","mian":"面包"},{"id":"mi32","name":"佛卡夏","en":"Focaccia","cuisine":"西餐","type":"主食","time":180,"level":1,"serves":8,"tags":["意大利","橄榄油","简单"],"ing":[{"n":"中筋面粉","q":500,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":400,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":2,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"盐","q":10,"u":"克","g":"调料","buy":"salt"},{"n":"橄榄油","q":6,"u":"汤匙","g":"调料","buy":"extra-virgin olive oil"},{"n":"海盐片、迷迭香、小番茄","q":0,"u":"适量","g":"配料","buy":"flaky sea salt, rosemary"}],"steps":[{"t":"面粉、酵母、盐、温水搅成湿黏的面团，不用揉，盖好。"},{"t":"每 30 分钟用湿手把面团四边往中间拉折一次，共 3 次，然后发到两倍大。","s":5400},{"t":"9×13 英寸烤盘倒 3 汤匙橄榄油，放入面团，用手指推开铺满，再发 30 分钟。","s":1800},{"t":"淋上剩下的橄榄油，用手指戳满深坑，撒海盐、迷迭香、番茄。"},{"t":"220°C（425°F）烤 25 分钟，底部金黄酥脆。","s":1500}],"tip":"油一定要多，底部是煎出来的脆。","mian":"面包"},{"id":"mi33","name":"肉桂卷","en":"Cinnamon Rolls","cuisine":"西餐","type":"甜点","time":180,"level":2,"serves":12,"tags":["美式","甜","周末"],"ing":[{"n":"中筋面粉","q":500,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"牛奶","q":240,"u":"毫升","g":"主料","buy":"milk"},{"n":"鸡蛋","q":2,"u":"个","g":"主料","buy":"eggs"},{"n":"黄油","q":115,"u":"克","g":"主料","buy":"butter"},{"n":"白糖","q":60,"u":"克","g":"调料","buy":"sugar"},{"n":"即发干酵母","q":2,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"红糖","q":150,"u":"克","g":"调料","buy":"brown sugar"},{"n":"肉桂粉","q":2,"u":"汤匙","g":"调料","buy":"ground cinnamon"},{"n":"奶油奶酪","q":115,"u":"克","g":"配料","buy":"cream cheese"},{"n":"糖粉","q":120,"u":"克","g":"配料","buy":"powdered sugar"}],"steps":[{"t":"温牛奶、一半黄油、白糖、酵母、鸡蛋加面粉揉成软面团，发酵到两倍大。","s":3600},{"t":"擀成约 40×30 厘米长方形，抹软化黄油，撒红糖和肉桂粉。"},{"t":"从长边卷紧，用线切成 12 段，排进烤盘，再发 45 分钟。","s":2700},{"t":"180°C（350°F）烤 25 分钟。","s":1500},{"t":"奶油奶酪、糖粉、少许牛奶打成糖霜，趁温抹上。"}],"tip":"用牙线切卷，不会压扁。","mian":"面包"},{"id":"mi34","name":"美式比斯吉","en":"Buttermilk Biscuits","cuisine":"西餐","type":"早餐","time":35,"level":1,"serves":8,"tags":["美国南方","快手","不用酵母"],"ing":[{"n":"中筋面粉","q":300,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"冷黄油","q":115,"u":"克","g":"主料","buy":"cold butter"},{"n":"酪乳 buttermilk","q":240,"u":"毫升","g":"主料","buy":"buttermilk"},{"n":"泡打粉","q":1,"u":"汤匙","g":"调料","buy":"baking powder"},{"n":"小苏打","q":0.5,"u":"茶匙","g":"调料","buy":"baking soda"},{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"salt"}],"steps":[{"t":"烤箱预热 220°C（425°F）。面粉、泡打粉、小苏打、盐混合。","s":600},{"t":"冷黄油切小丁（或冻硬后擦丝）拌进面粉，用手指搓到有豌豆大的黄油粒。"},{"t":"倒入冰的酪乳，拌到刚成团就停，不要揉。"},{"t":"拍成长方形，对折再拍开，重复 4 次出层次，最后拍成 2 厘米厚，用杯口直着压下切圆。"},{"t":"贴在一起放烤盘，烤 15 分钟到金黄。","s":900}],"tip":"一切都要冷，越冷层次越多。没有酪乳就用牛奶加 1 汤匙白醋放 5 分钟。配肉汁（biscuits and gravy）是南方早餐。","mian":"面包"},{"id":"mi35","name":"口袋饼 Pita","en":"Homemade Pita Bread","cuisine":"西餐","type":"主食","time":120,"level":2,"serves":8,"tags":["中东","鼓包"],"ing":[{"n":"中筋面粉","q":400,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":250,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1.5,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"橄榄油","q":2,"u":"汤匙","g":"调料","buy":"olive oil"},{"n":"糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},{"n":"盐","q":1.5,"u":"茶匙","g":"调料","buy":"salt"}],"steps":[{"t":"所有材料揉成光滑柔软的面团，发酵 1 小时。","s":3600},{"t":"分成 8 份搓圆，醒 10 分钟，擀成约 5 毫米厚的圆饼。","s":600},{"t":"铸铁锅或烤箱 260°C（500°F）预热好的烤盘，放饼烤 3 分钟左右，会鼓成气球。","s":180},{"t":"出炉用布包住，会慢慢塌下变软，中间是口袋。"}],"tip":"鼓不起来通常是温度不够或擀得不均匀。","mian":"面包"},{"id":"mi36","name":"纽约薄底披萨","en":"New York Style Pizza","cuisine":"西餐","type":"主食","time":1500,"level":2,"serves":4,"tags":["纽约","冷藏发酵"],"ing":[{"n":"高筋面粉","q":500,"u":"克","g":"主料","buy":"bread flour"},{"n":"冷水","q":325,"u":"毫升","g":"主料","buy":"cold water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"盐","q":10,"u":"克","g":"调料","buy":"salt"},{"n":"糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},{"n":"橄榄油","q":1,"u":"汤匙","g":"调料","buy":"olive oil"},{"n":"番茄碎罐头","q":1,"u":"罐","g":"主料","buy":"crushed tomatoes"},{"n":"马苏里拉奶酪（低水分）","q":400,"u":"克","g":"主料","buy":"low-moisture mozzarella"},{"n":"牛至、蒜粉","q":0,"u":"适量","g":"调料","buy":"oregano"}],"steps":[{"t":"所有面团材料揉 8 分钟成光滑面团，分成 2 个圆团，各放进抹油的保鲜盒，冷藏 24–72 小时。","s":86400},{"t":"烤前 2 小时拿出回温。烤箱放披萨石或倒扣的烤盘，开到最高温（260–290°C）预热 45 分钟。","s":2700},{"t":"番茄碎加盐、牛至、蒜粉，不用煮。"},{"t":"面团用手从中间往外推开成 35 厘米的薄饼，边缘留厚。"},{"t":"抹薄薄一层酱、撒奶酪，滑到烫石头上烤 7–9 分钟，饼边起泡焦黄。","s":480}],"tip":"冷藏发酵越久越香、越有嚼劲。奶酪要用低水分的整块现擦，不会出水。","mian":"披萨"},{"id":"mi37","name":"平底锅披萨","en":"Skillet Pizza","cuisine":"西餐","type":"主食","time":30,"level":1,"serves":2,"tags":["快手","不用烤箱发酵"],"ing":[{"n":"中筋面粉","q":200,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"温水","q":130,"u":"毫升","g":"主料","buy":"warm water"},{"n":"即发干酵母","q":1,"u":"茶匙","g":"主料","buy":"instant yeast"},{"n":"盐","q":0.5,"u":"茶匙","g":"调料","buy":"salt"},{"n":"橄榄油","q":2,"u":"汤匙","g":"调料","buy":"olive oil"},{"n":"番茄酱（披萨酱）","q":4,"u":"汤匙","g":"主料","buy":"pizza sauce"},{"n":"马苏里拉奶酪","q":150,"u":"克","g":"主料","buy":"mozzarella"},{"n":"意式辣香肠","q":0,"u":"适量","g":"配料","buy":"pepperoni"}],"steps":[{"t":"面粉、酵母、盐、温水和 1 汤匙油揉成团，醒 15 分钟（不用等发酵）。","s":900},{"t":"铸铁平底锅抹油，面团直接按进锅里铺满。"},{"t":"中火煎 3 分钟到底部金黄，抹酱、撒奶酪和配料。","s":180},{"t":"放进烤箱上层用 broil（上火）烤 3–4 分钟，奶酪化开起泡。没有烤箱就盖盖小火焖 5 分钟。","s":240}],"tip":"下班后半小时就能吃上，比外卖快。","mian":"披萨"},{"id":"mi38","name":"荷兰宝贝松饼","en":"Dutch Baby Pancake","cuisine":"西餐","type":"早餐","time":30,"level":1,"serves":3,"tags":["铸铁锅","周末早餐"],"ing":[{"n":"中筋面粉","q":65,"u":"克","g":"主料","buy":"all-purpose flour"},{"n":"鸡蛋","q":3,"u":"个","g":"主料","buy":"eggs"},{"n":"牛奶","q":120,"u":"毫升","g":"主料","buy":"milk"},{"n":"黄油","q":3,"u":"汤匙","g":"主料","buy":"butter"},{"n":"糖","q":1,"u":"汤匙","g":"调料","buy":"sugar"},{"n":"柠檬、糖粉、浆果","q":0,"u":"适量","g":"配料","buy":"lemon, powdered sugar, berries"}],"steps":[{"t":"铸铁锅放进烤箱，预热到 220°C（425°F）。","s":900},{"t":"鸡蛋、牛奶、面粉、糖、一小撮盐用搅拌机打 30 秒成顺滑面糊（室温最好）。"},{"t":"取出烫锅放黄油，化开晃匀，马上倒面糊。"},{"t":"烤 18–20 分钟，四边会鼓得很高，中间金黄。烤的时候别开门。","s":1140},{"t":"出炉很快会塌，马上挤柠檬汁、撒糖粉和浆果吃。"}],"tip":"锅一定要烫，面糊倒进去立刻滋滋响才会鼓起来。","mian":"煎饼华夫"}]}