{"items":[
{"id":"we01","name":"番茄肉酱意面","en":"Spaghetti Bolognese","cuisine":"西餐","type":"主食","time":45,"level":1,"serves":2,"tags":["经典","带饭"],
"ing":[
{"n":"意大利面","q":200,"u":"克","g":"主料","buy":"spaghetti"},
{"n":"牛肉末","q":250,"u":"克","g":"主料","buy":"ground beef 80/20"},
{"n":"洋葱","q":0.5,"u":"个","g":"配料","buy":"yellow onion"},
{"n":"胡萝卜","q":0.5,"u":"根","g":"配料","buy":"carrot"},
{"n":"西芹","q":1,"u":"根","g":"配料","buy":"celery"},
{"n":"大蒜","q":2,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"番茄碎罐头","q":400,"u":"克","g":"配料","buy":"crushed tomatoes (can)"},
{"n":"番茄膏","q":1,"u":"汤匙","g":"调料","buy":"tomato paste"},
{"n":"橄榄油","q":1,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"},
{"n":"帕玛森芝士粉","q":0,"u":"适量","g":"调料","buy":"grated parmesan"}],
"steps":[
{"t":"洋葱、胡萝卜、西芹切成小丁，大蒜切末。"},
{"t":"锅中放橄榄油中火加热，下蔬菜丁炒软出香，约 5 分钟。","s":300},
{"t":"加入牛肉末，用铲子压散，炒到完全变色无粉红（内部 160°F / 71°C）。"},
{"t":"加入蒜末和番茄膏炒 1 分钟，再倒入番茄碎，加盐和黑胡椒。"},
{"t":"转小火加盖，留一条缝，慢炖 20 分钟，期间搅拌几次防粘底。","s":1200},
{"t":"同时大锅烧水，水开后加一大勺盐，下意面煮 9 分钟（按包装时间减 1 分钟）。","s":540},
{"t":"捞出意面直接放进肉酱锅，加 2–3 汤匙煮面水翻拌均匀，装盘撒芝士粉。"}],
"tip":"肉酱一次做双份，分装冷冻可存 3 个月，下班煮个面就能吃。"},

{"id":"we02","name":"蒜香橄榄油意面","en":"Spaghetti Aglio e Olio","cuisine":"西餐","type":"主食","time":20,"level":1,"serves":2,"tags":["快手","素食"],
"ing":[
{"n":"意大利面","q":200,"u":"克","g":"主料","buy":"spaghetti"},
{"n":"大蒜","q":6,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"新鲜欧芹","q":0,"u":"少许","g":"配料","buy":"Italian parsley"},
{"n":"特级初榨橄榄油","q":60,"u":"毫升","g":"调料","buy":"extra virgin olive oil"},
{"n":"干辣椒碎","q":0.5,"u":"茶匙","g":"调料","buy":"crushed red pepper flakes"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"},
{"n":"帕玛森芝士粉","q":0,"u":"少许","g":"调料","buy":"grated parmesan"}],
"steps":[
{"t":"大锅烧水，加一大勺盐，下意面煮 8 分钟，比包装时间少 1–2 分钟。","s":480},
{"t":"煮面同时，大蒜切薄片，欧芹切碎。"},
{"t":"平底锅倒入橄榄油和蒜片，小火慢慢加热，蒜片微微金黄即可，不要炸焦发苦。"},
{"t":"加入辣椒碎，舀约 120 毫升煮面水倒进锅里，晃锅让油水乳化。"},
{"t":"意面捞入锅中，中火翻拌 1–2 分钟，让酱汁挂在面上，太干就再加煮面水。"},
{"t":"关火撒欧芹，尝味补盐，喜欢可撒少许芝士。"}],
"tip":"关键是煮面水里的淀粉，它让油变成能挂住面条的酱汁，别全倒掉。"},

{"id":"we03","name":"奶油培根意面","en":"Spaghetti Carbonara","cuisine":"西餐","type":"主食","time":25,"level":2,"serves":2,"tags":["经典","快手"],
"ing":[
{"n":"意大利面","q":200,"u":"克","g":"主料","buy":"spaghetti"},
{"n":"培根","q":120,"u":"克","g":"主料","buy":"thick-cut bacon"},
{"n":"鸡蛋","q":2,"u":"个","g":"主料","buy":"large eggs"},
{"n":"蛋黄","q":1,"u":"个","g":"主料","buy":"large eggs"},
{"n":"帕玛森芝士（现刨）","q":50,"u":"克","g":"配料","buy":"Parmigiano Reggiano wedge"},
{"n":"黑胡椒（现磨）","q":1,"u":"茶匙","g":"调料","buy":"whole black peppercorns"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"}],
"steps":[
{"t":"碗中打入 2 个全蛋和 1 个蛋黄，加入刨好的芝士和黑胡椒，搅成浓稠的蛋糊。"},
{"t":"培根切成小条，冷锅下锅，中小火慢煎至出油微脆，约 6 分钟，关火留油。","s":360},
{"t":"大锅烧水加盐，下意面煮 9 分钟。","s":540},
{"t":"留出一杯煮面水，意面捞进培根锅里（此时锅已离火），稍放 30 秒让温度降一点。"},
{"t":"倒入蛋糊，快速不停翻拌，一点点加入煮面水，直到酱汁顺滑如奶油、蛋液变稠但没有结块。"},
{"t":"立即装盘，再磨一点黑胡椒和芝士。"}],
"tip":"正宗做法不放奶油；锅一定要离火再下蛋，否则会变成炒蛋。担心生蛋可选巴氏杀菌蛋（pasteurized eggs）。"},

{"id":"we04","name":"香煎牛排","en":"Pan-Seared Ribeye Steak","cuisine":"西餐","type":"主菜","time":30,"level":2,"serves":2,"tags":["经典","请客"],
"ing":[
{"n":"肋眼牛排（约 2.5 厘米厚）","q":450,"u":"克","g":"主料","buy":"ribeye steak (Choice or Prime)"},
{"n":"黄油","q":2,"u":"汤匙","g":"配料","buy":"unsalted butter"},
{"n":"大蒜","q":3,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"新鲜迷迭香或百里香","q":2,"u":"根","g":"配料","buy":"fresh rosemary"},
{"n":"高烟点食用油","q":1,"u":"汤匙","g":"调料","buy":"avocado oil"},
{"n":"粗盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"牛排提前 30–40 分钟从冰箱取出，用厨房纸吸干表面水分，两面均匀撒盐。","s":2100},
{"t":"铸铁锅或厚底锅大火烧到冒轻烟，倒油，放入牛排，不要移动，煎 3 分钟。","s":180},
{"t":"翻面再煎 2 分钟，用夹子竖起来把边上的肥边也煎一下。","s":120},
{"t":"转中小火，放入黄油、拍扁的大蒜和香草，倾斜锅身用勺子把热黄油不断浇在牛排上约 1 分钟。","s":60},
{"t":"用肉温计测最厚处：三分熟 130°F / 54°C，五分熟 140°F / 60°C；USDA 建议 145°F / 63°C。"},
{"t":"移到砧板静置 5–8 分钟让肉汁回流，然后逆纹切片，撒黑胡椒。","s":360}],
"tip":"Costco 的 Prime 肋眼性价比很高；锅一定要够热，才能煎出焦香外壳。"},

{"id":"we05","name":"香烤鸡腿","en":"Oven-Roasted Chicken Thighs","cuisine":"西餐","type":"主菜","time":50,"level":1,"serves":2,"tags":["烤箱","带饭"],
"ing":[
{"n":"带骨带皮鸡腿（琵琶腿或大腿）","q":800,"u":"克","g":"主料","buy":"bone-in skin-on chicken thighs"},
{"n":"橄榄油","q":1,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"蒜粉","q":1,"u":"茶匙","g":"调料","buy":"garlic powder"},
{"n":"烟熏红椒粉","q":1,"u":"茶匙","g":"调料","buy":"smoked paprika"},
{"n":"干牛至或意式香草","q":0.5,"u":"茶匙","g":"调料","buy":"Italian seasoning"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0.5,"u":"茶匙","g":"调料","buy":"black pepper"},
{"n":"柠檬","q":0.5,"u":"个","g":"配料","buy":"lemon"}],
"steps":[
{"t":"烤箱预热到 425°F / 220°C，烤盘铺锡纸放烤架。"},
{"t":"鸡腿用厨房纸彻底擦干，鸡皮干才会脆。"},
{"t":"把所有干调料混合，鸡腿先抹油再均匀撒满调料，皮朝上放在烤架上。"},
{"t":"放入烤箱烤 35–40 分钟，至表皮金黄酥脆。","s":2280},
{"t":"用肉温计插入最厚处（不碰骨头），至少达到 165°F / 74°C；腿肉烤到 175–185°F 口感更嫩不柴。"},
{"t":"出炉静置 5 分钟，挤上柠檬汁即可。","s":300}],
"tip":"Walmart 和 Food 4 Less 的家庭装鸡腿最便宜，一次腌好分袋冷冻，随取随烤。"},

{"id":"we06","name":"经典芝士牛肉汉堡","en":"Classic Cheeseburger","cuisine":"西餐","type":"主食","time":25,"level":1,"serves":2,"tags":["美式","快手"],
"ing":[
{"n":"牛肉末（80/20）","q":340,"u":"克","g":"主料","buy":"ground beef 80/20"},
{"n":"汉堡面包","q":2,"u":"个","g":"主料","buy":"hamburger buns (brioche)"},
{"n":"切达或美式芝士片","q":2,"u":"片","g":"配料","buy":"American cheese slices"},
{"n":"生菜叶","q":2,"u":"片","g":"配料","buy":"green leaf lettuce"},
{"n":"番茄","q":1,"u":"个","g":"配料","buy":"tomato"},
{"n":"红洋葱","q":0.25,"u":"个","g":"配料","buy":"red onion"},
{"n":"酸黄瓜片","q":4,"u":"片","g":"配料","buy":"dill pickle chips"},
{"n":"番茄酱、芥末酱","q":0,"u":"适量","g":"调料","buy":"ketchup, yellow mustard"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"番茄、洋葱切片，生菜洗净擦干。"},
{"t":"牛肉末分成两份，轻轻捏成比面包略大、约 2 厘米厚的肉饼，中间用拇指按一个浅窝防止鼓起。不要反复揉捏。"},
{"t":"肉饼两面撒盐和黑胡椒。平底锅中大火烧热，放入肉饼煎 4 分钟。","s":240},
{"t":"翻面再煎 3 分钟，最后 1 分钟放上芝士片，盖锅盖让芝士融化。","s":180},
{"t":"确认肉饼中心达到 160°F / 71°C（牛肉末需全熟）。"},
{"t":"面包切面朝下在锅里烘 30 秒，依次叠上酱料、生菜、番茄、肉饼、洋葱和酸黄瓜。"}],
"tip":"盐在下锅前才撒，提前混进肉里会让肉饼变得紧实像香肠。"},

{"id":"we07","name":"墨西哥烤牛肉塔可","en":"Carne Asada Tacos","cuisine":"西餐","type":"主菜","time":80,"level":2,"serves":3,"tags":["墨西哥","请客"],
"ing":[
{"n":"裙边牛排或侧腹牛排","q":680,"u":"克","g":"主料","buy":"skirt steak or flank steak"},
{"n":"玉米饼","q":12,"u":"张","g":"主料","buy":"corn tortillas"},
{"n":"橙汁","q":80,"u":"毫升","g":"调料","buy":"orange juice"},
{"n":"青柠","q":3,"u":"个","g":"配料","buy":"limes"},
{"n":"大蒜","q":4,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"香菜","q":1,"u":"把","g":"配料","buy":"cilantro"},
{"n":"白洋葱","q":0.5,"u":"个","g":"配料","buy":"white onion"},
{"n":"墨西哥青辣椒","q":1,"u":"个","g":"配料","buy":"jalapeño"},
{"n":"孜然粉","q":1,"u":"茶匙","g":"调料","buy":"ground cumin"},
{"n":"辣椒粉","q":1,"u":"茶匙","g":"调料","buy":"chili powder"},
{"n":"生抽或酱油","q":1,"u":"汤匙","g":"调料","buy":"soy sauce"},
{"n":"食用油","q":2,"u":"汤匙","g":"调料","buy":"vegetable oil"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"莎莎酱","q":0,"u":"适量","g":"调料","buy":"salsa verde or pico de gallo"}],
"steps":[
{"t":"腌料：橙汁、2 个青柠的汁、蒜末、半把切碎的香菜、切碎的青辣椒、孜然、辣椒粉、酱油、油和盐混匀。"},
{"t":"牛排放入保鲜袋倒入腌料，揉匀后冷藏至少 1 小时（最多 8 小时，太久肉会变糊）。","s":3600},
{"t":"取出牛排擦掉多余腌料。铸铁锅或烤架大火烧到冒烟，每面煎 4–5 分钟至表面焦香。","s":540},
{"t":"内部温度达到 130–135°F 为三到五分熟，USDA 建议 145°F / 63°C。移出静置 5 分钟。","s":300},
{"t":"逆着肉纹切成小块或细条（这一步决定嚼不嚼得动）。"},
{"t":"玉米饼在干锅里每面烘 20–30 秒至柔软带焦点，叠起用毛巾包住保温。"},
{"t":"玉米饼两张叠用，放上牛肉，撒洋葱丁和香菜碎，配莎莎酱和青柠角。"}],
"tip":"Food 4 Less 和墨西哥超市肉柜有现成腌好的 carne asada，直接煎就行，省掉腌制时间。"},

{"id":"we08","name":"鸡肉芝士薄饼","en":"Chicken Quesadilla","cuisine":"西餐","type":"小吃","time":15,"level":1,"serves":2,"tags":["墨西哥","快手"],
"ing":[
{"n":"大号面粉饼","q":2,"u":"张","g":"主料","buy":"burrito-size flour tortillas"},
{"n":"熟鸡肉（撕成丝）","q":200,"u":"克","g":"主料","buy":"rotisserie chicken"},
{"n":"墨西哥混合芝士丝","q":150,"u":"克","g":"主料","buy":"shredded Mexican blend cheese"},
{"n":"甜椒","q":0.5,"u":"个","g":"配料","buy":"bell pepper"},
{"n":"黄油","q":1,"u":"汤匙","g":"调料","buy":"butter"},
{"n":"辣椒粉","q":0.5,"u":"茶匙","g":"调料","buy":"chili powder"},
{"n":"酸奶油、莎莎酱","q":0,"u":"适量","g":"调料","buy":"sour cream, salsa"}],
"steps":[
{"t":"甜椒切细丁，与鸡肉丝和辣椒粉拌匀。"},
{"t":"面粉饼平铺，一半面积撒一层芝士，铺上鸡肉甜椒，再撒一层芝士，对折成半月形。"},
{"t":"平底锅中小火放一半黄油，放入薄饼，用铲子轻压，煎 2–3 分钟至底面金黄。","s":150},
{"t":"小心翻面，补一点黄油，再煎 2 分钟至芝士完全融化。","s":120},
{"t":"出锅静置 1 分钟再切成三角，配酸奶油和莎莎酱。"}],
"tip":"Costco 的 4.99 美元烤鸡撕成丝，配这道和墨西哥饭碗都特别方便。"},

{"id":"we09","name":"牛油果酱","en":"Guacamole","cuisine":"西餐","type":"小吃","time":10,"level":1,"serves":4,"tags":["墨西哥","素食","免开火"],
"ing":[
{"n":"熟牛油果","q":3,"u":"个","g":"主料","buy":"Hass avocados"},
{"n":"青柠","q":1,"u":"个","g":"配料","buy":"lime"},
{"n":"白洋葱","q":0.25,"u":"个","g":"配料","buy":"white onion"},
{"n":"罗马番茄","q":1,"u":"个","g":"配料","buy":"Roma tomato"},
{"n":"墨西哥青辣椒","q":1,"u":"个","g":"配料","buy":"jalapeño"},
{"n":"香菜","q":0,"u":"少许","g":"配料","buy":"cilantro"},
{"n":"盐","q":0.5,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"玉米片","q":0,"u":"适量","g":"配料","buy":"tortilla chips"}],
"steps":[
{"t":"洋葱、番茄（去籽）、青辣椒（去籽去筋可减辣）切小丁，香菜切碎。"},
{"t":"牛油果对半切开去核，挖出果肉放入碗中。"},
{"t":"挤入青柠汁、加盐，用叉子压成带颗粒的泥，不用压得太细。"},
{"t":"拌入洋葱、番茄、辣椒和香菜，尝味补盐或青柠汁，配玉米片吃。"}],
"tip":"挑牛油果要选按压微软、蒂头那一小块抠下来是绿色的；剩下的酱表面贴保鲜膜可减缓变黑。"},

{"id":"we10","name":"墨西哥鸡肉饭碗","en":"Chicken Burrito Bowl","cuisine":"西餐","type":"主食","time":40,"level":1,"serves":2,"tags":["墨西哥","带饭","健康"],
"ing":[
{"n":"去骨鸡腿肉","q":450,"u":"克","g":"主料","buy":"boneless skinless chicken thighs"},
{"n":"长粒米","q":1,"u":"杯","g":"主料","buy":"long grain white rice"},
{"n":"黑豆罐头（沥干）","q":425,"u":"克","g":"配料","buy":"black beans (can)"},
{"n":"玉米粒","q":1,"u":"杯","g":"配料","buy":"frozen sweet corn"},
{"n":"生菜丝","q":2,"u":"杯","g":"配料","buy":"romaine lettuce"},
{"n":"芝士丝","q":60,"u":"克","g":"配料","buy":"shredded Mexican blend cheese"},
{"n":"青柠","q":1,"u":"个","g":"配料","buy":"lime"},
{"n":"香菜","q":0,"u":"少许","g":"配料","buy":"cilantro"},
{"n":"辣椒粉","q":2,"u":"茶匙","g":"调料","buy":"chili powder"},
{"n":"孜然粉","q":1,"u":"茶匙","g":"调料","buy":"ground cumin"},
{"n":"蒜粉","q":0.5,"u":"茶匙","g":"调料","buy":"garlic powder"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"食用油","q":1,"u":"汤匙","g":"调料","buy":"vegetable oil"},
{"n":"莎莎酱、酸奶油","q":0,"u":"适量","g":"调料","buy":"salsa, sour cream"}],
"steps":[
{"t":"米洗净，按 1 杯米 1.5 杯水煮熟（电饭锅即可），煮好后拌入半个青柠汁和香菜碎。"},
{"t":"鸡腿肉用辣椒粉、孜然、蒜粉、盐和油抓匀，腌 10 分钟。","s":600},
{"t":"平底锅中大火烧热，放入鸡肉每面煎 5–6 分钟，至中心达到 165°F / 74°C。","s":660},
{"t":"鸡肉静置 5 分钟后切块。同时黑豆和玉米加热（玉米可在同一锅里炒到微焦更香）。","s":300},
{"t":"碗里先放米饭，再分区摆上鸡肉、黑豆、玉米、生菜、芝士，最后加莎莎酱、酸奶油，挤青柠汁。"}],
"tip":"做 4 份分装进饭盒，酸奶油和生菜吃前再加，就是一周的 Chipotle 平替午饭。"},

{"id":"we11","name":"凯撒沙拉","en":"Caesar Salad","cuisine":"西餐","type":"凉菜","time":15,"level":1,"serves":2,"tags":["经典","免开火"],
"ing":[
{"n":"罗马生菜心","q":2,"u":"颗","g":"主料","buy":"romaine hearts"},
{"n":"面包丁","q":1,"u":"杯","g":"配料","buy":"croutons"},
{"n":"帕玛森芝士（现刨）","q":30,"u":"克","g":"配料","buy":"Parmigiano Reggiano wedge"},
{"n":"蛋黄酱","q":3,"u":"汤匙","g":"调料","buy":"mayonnaise"},
{"n":"柠檬汁","q":1,"u":"汤匙","g":"调料","buy":"lemon"},
{"n":"第戎芥末酱","q":1,"u":"茶匙","g":"调料","buy":"Dijon mustard"},
{"n":"伍斯特酱","q":0.5,"u":"茶匙","g":"调料","buy":"Worcestershire sauce"},
{"n":"凤尾鱼酱（可选）","q":1,"u":"茶匙","g":"调料","buy":"anchovy paste"},
{"n":"大蒜","q":1,"u":"瓣","g":"调料","buy":"garlic"},
{"n":"橄榄油","q":1,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"生菜心洗净，彻底甩干或用厨房纸吸干，切或撕成大块冷藏备用。"},
{"t":"大蒜磨成泥，与蛋黄酱、柠檬汁、芥末酱、伍斯特酱、凤尾鱼酱和橄榄油搅匀。"},
{"t":"拌入一半刨好的芝士和大量黑胡椒，太稠可加 1 茶匙水调开。"},
{"t":"吃之前把生菜和酱汁拌匀，撒面包丁和剩下的芝士。"}],
"tip":"用蛋黄酱代替生蛋黄更安全也更稳定；加一块煎鸡胸就是一顿正餐。"},

{"id":"we12","name":"希腊沙拉","en":"Greek Salad","cuisine":"西餐","type":"凉菜","time":15,"level":1,"serves":2,"tags":["素食","健康","免开火"],
"ing":[
{"n":"黄瓜","q":1,"u":"根","g":"主料","buy":"English cucumber"},
{"n":"罗马番茄","q":3,"u":"个","g":"主料","buy":"Roma tomatoes"},
{"n":"红洋葱","q":0.25,"u":"个","g":"配料","buy":"red onion"},
{"n":"青椒","q":0.5,"u":"个","g":"配料","buy":"green bell pepper"},
{"n":"卡拉马塔黑橄榄","q":60,"u":"克","g":"配料","buy":"Kalamata olives"},
{"n":"菲达奶酪","q":100,"u":"克","g":"配料","buy":"feta cheese block"},
{"n":"特级初榨橄榄油","q":3,"u":"汤匙","g":"调料","buy":"extra virgin olive oil"},
{"n":"红酒醋","q":1,"u":"汤匙","g":"调料","buy":"red wine vinegar"},
{"n":"干牛至","q":1,"u":"茶匙","g":"调料","buy":"dried oregano"},
{"n":"盐","q":0,"u":"少许","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"少许","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"黄瓜纵切再切厚半月片，番茄切块，青椒切条，红洋葱切细丝（泡冷水 5 分钟可去辛辣）。"},
{"t":"蔬菜和橄榄放入大碗，撒少许盐和黑胡椒。"},
{"t":"橄榄油、红酒醋和一半牛至混合，淋在蔬菜上轻轻拌匀。"},
{"t":"菲达奶酪切大块或整块放在最上面，撒剩下的牛至，再淋一点橄榄油。"}],
"tip":"正宗希腊沙拉不放生菜；买整块泡在盐水里的菲达，比碎粒的更香更湿润。"},

{"id":"we13","name":"奶油蘑菇汤","en":"Cream of Mushroom Soup","cuisine":"西餐","type":"汤","time":40,"level":1,"serves":4,"tags":["暖胃","素食可做"],
"ing":[
{"n":"褐色蘑菇","q":450,"u":"克","g":"主料","buy":"baby bella (cremini) mushrooms"},
{"n":"洋葱","q":0.5,"u":"个","g":"配料","buy":"yellow onion"},
{"n":"大蒜","q":2,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"黄油","q":30,"u":"克","g":"调料","buy":"butter"},
{"n":"中筋面粉","q":2,"u":"汤匙","g":"调料","buy":"all-purpose flour"},
{"n":"鸡汤或蔬菜高汤","q":480,"u":"毫升","g":"配料","buy":"chicken broth"},
{"n":"淡奶油","q":120,"u":"毫升","g":"配料","buy":"heavy cream"},
{"n":"干百里香","q":0.5,"u":"茶匙","g":"调料","buy":"dried thyme"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"蘑菇用湿纸巾擦净切片，留几片做装饰；洋葱切丁，大蒜切末。"},
{"t":"汤锅中火融化黄油，下洋葱炒软约 4 分钟，加蘑菇和少许盐，炒到出水再收干、表面微焦，约 8 分钟。","s":720},
{"t":"加入蒜末和百里香炒 30 秒，撒入面粉翻炒 1 分钟去生粉味。"},
{"t":"边搅边慢慢倒入高汤，煮开后转小火煮 15 分钟。","s":900},
{"t":"用手持料理棒打成半顺滑（留一点颗粒口感更好），或盛出一半用搅拌机打碎再倒回。"},
{"t":"倒入淡奶油小火加热不沸腾，加盐和黑胡椒调味。"}],
"tip":"蘑菇一定要炒到水分收干、颜色变深，汤的香味主要来自这一步。"},

{"id":"we14","name":"番茄汤配烤奶酪三明治","en":"Tomato Soup & Grilled Cheese","cuisine":"西餐","type":"汤","time":40,"level":1,"serves":2,"tags":["美式","暖胃"],
"ing":[
{"n":"整番茄罐头","q":800,"u":"克","g":"主料","buy":"whole peeled tomatoes (28 oz can)"},
{"n":"洋葱","q":0.5,"u":"个","g":"配料","buy":"yellow onion"},
{"n":"大蒜","q":2,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"鸡汤或蔬菜高汤","q":360,"u":"毫升","g":"配料","buy":"chicken broth"},
{"n":"淡奶油","q":60,"u":"毫升","g":"配料","buy":"heavy cream"},
{"n":"黄油（煮汤）","q":2,"u":"汤匙","g":"调料","buy":"butter"},
{"n":"白糖","q":1,"u":"茶匙","g":"调料","buy":"sugar"},
{"n":"吐司面包","q":4,"u":"片","g":"主料","buy":"sourdough or white sandwich bread"},
{"n":"切达芝士片","q":4,"u":"片","g":"主料","buy":"sharp cheddar slices"},
{"n":"黄油（煎三明治，软化）","q":2,"u":"汤匙","g":"调料","buy":"butter"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"汤锅中火融化黄油，下洋葱丁炒软约 5 分钟，加蒜末炒香。","s":300},
{"t":"倒入番茄罐头（用勺子压碎）、高汤和糖，煮开后转小火煮 20 分钟。","s":1200},
{"t":"关火用料理棒打至顺滑，拌入淡奶油，加盐和黑胡椒调味，小火保温。"},
{"t":"煮汤的同时做三明治：面包外侧一面抹软化黄油，抹黄油的一面朝外，中间夹两片芝士。"},
{"t":"平底锅中小火，放入三明治煎 3 分钟至金黄，翻面再煎 3 分钟至芝士融化。","s":360},
{"t":"三明治切成两半或长条，蘸番茄汤吃。"}],
"tip":"火要小、慢慢煎，面包才不会外面焦了里面芝士还没化；黄油里拌一点蛋黄酱更金黄酥脆。"},

{"id":"we15","name":"美式辣肉酱","en":"Beef Chili","cuisine":"西餐","type":"主菜","time":60,"level":1,"serves":4,"tags":["美式","带饭","一锅出"],
"ing":[
{"n":"牛肉末","q":450,"u":"克","g":"主料","buy":"ground beef 85/15"},
{"n":"红芸豆罐头（沥干）","q":425,"u":"克","g":"主料","buy":"kidney beans (can)"},
{"n":"番茄丁罐头","q":411,"u":"克","g":"配料","buy":"diced tomatoes (14.5 oz can)"},
{"n":"番茄酱汁罐头","q":227,"u":"克","g":"配料","buy":"tomato sauce (8 oz can)"},
{"n":"洋葱","q":1,"u":"个","g":"配料","buy":"yellow onion"},
{"n":"甜椒","q":1,"u":"个","g":"配料","buy":"bell pepper"},
{"n":"大蒜","q":3,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"牛肉高汤","q":240,"u":"毫升","g":"配料","buy":"beef broth"},
{"n":"辣椒粉","q":2,"u":"汤匙","g":"调料","buy":"chili powder"},
{"n":"孜然粉","q":1,"u":"汤匙","g":"调料","buy":"ground cumin"},
{"n":"干牛至","q":1,"u":"茶匙","g":"调料","buy":"dried oregano"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"食用油","q":1,"u":"汤匙","g":"调料","buy":"vegetable oil"},
{"n":"芝士丝、酸奶油、葱花","q":0,"u":"适量","g":"配料","buy":"shredded cheddar, sour cream, green onions"}],
"steps":[
{"t":"洋葱、甜椒切丁，大蒜切末。"},
{"t":"厚底锅中大火放油，下牛肉末压散炒至完全变色（160°F / 71°C），油太多可倒掉一些。"},
{"t":"加入洋葱和甜椒炒软约 5 分钟，再加蒜末、辣椒粉、孜然、牛至翻炒 1 分钟炒出香味。","s":300},
{"t":"倒入番茄丁、番茄酱汁、高汤和红芸豆，加盐搅匀煮开。"},
{"t":"转小火半盖锅盖炖 30–40 分钟，偶尔搅拌，炖到浓稠。","s":2100},
{"t":"尝味调整盐和辣度，盛碗撒芝士丝、酸奶油和葱花。"}],
"tip":"放一晚第二天更好吃；可以配米饭、玉米面包，或浇在烤土豆和热狗上。"},

{"id":"we16","name":"美式松饼","en":"Buttermilk-Style Pancakes","cuisine":"西餐","type":"早餐","time":25,"level":1,"serves":2,"tags":["早餐","甜"],
"ing":[
{"n":"中筋面粉","q":1,"u":"杯","g":"主料","buy":"all-purpose flour"},
{"n":"牛奶","q":240,"u":"毫升","g":"主料","buy":"whole milk"},
{"n":"鸡蛋","q":1,"u":"个","g":"主料","buy":"large eggs"},
{"n":"融化黄油","q":2,"u":"汤匙","g":"配料","buy":"butter"},
{"n":"白糖","q":1,"u":"汤匙","g":"调料","buy":"sugar"},
{"n":"泡打粉","q":2,"u":"茶匙","g":"调料","buy":"baking powder"},
{"n":"盐","q":0.25,"u":"茶匙","g":"调料","buy":"salt"},
{"n":"香草精","q":0.5,"u":"茶匙","g":"调料","buy":"vanilla extract"},
{"n":"枫糖浆、浆果","q":0,"u":"适量","g":"配料","buy":"maple syrup, berries"}],
"steps":[
{"t":"大碗中混合面粉、糖、泡打粉和盐。"},
{"t":"另一碗打散鸡蛋，加牛奶、融化黄油（稍放凉）和香草精搅匀。"},
{"t":"湿料倒入干料，用刮刀拌到看不见干粉即可，有小疙瘩没关系，千万别搅过头。静置 5 分钟。","s":300},
{"t":"不粘锅中小火加热，抹一层薄黄油，每次舀约 1/4 杯面糊。"},
{"t":"煎到表面冒出很多小泡、边缘变干，约 2 分钟，翻面再煎 1 分钟。","s":120},
{"t":"叠起来淋枫糖浆，放浆果和一小块黄油。"}],
"tip":"牛奶里加 1 汤匙白醋或柠檬汁放 5 分钟，就是自制 buttermilk，松饼会更蓬松。"},

{"id":"we17","name":"美式炒蛋配培根","en":"Soft Scrambled Eggs & Bacon","cuisine":"西餐","type":"早餐","time":25,"level":1,"serves":2,"tags":["早餐","快手"],
"ing":[
{"n":"鸡蛋","q":4,"u":"个","g":"主料","buy":"large eggs"},
{"n":"培根","q":6,"u":"片","g":"主料","buy":"bacon"},
{"n":"牛奶","q":2,"u":"汤匙","g":"配料","buy":"whole milk"},
{"n":"黄油","q":1,"u":"汤匙","g":"调料","buy":"butter"},
{"n":"吐司面包","q":2,"u":"片","g":"配料","buy":"sandwich bread"},
{"n":"香葱","q":0,"u":"少许","g":"配料","buy":"chives or green onion"},
{"n":"盐","q":0,"u":"适量","g":"调料","buy":"salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"烤箱预热到 400°F / 200°C，培根平铺在铺了锡纸的烤盘上，互不重叠。"},
{"t":"烤 15–18 分钟至想要的脆度，取出放在厨房纸上吸油。","s":1020},
{"t":"烤培根的同时，鸡蛋加牛奶和一小撮盐充分打散至没有蛋清丝。"},
{"t":"不粘锅小火融化黄油，倒入蛋液，静置几秒后用硅胶铲从边缘往中间慢慢推。"},
{"t":"蛋液八成凝固、表面还湿润发亮时立刻关火，用余温推几下即可出锅。"},
{"t":"撒黑胡椒和葱花，配培根和烤好的吐司。"}],
"tip":"炒蛋的秘诀是小火加提前离火，盛到盘子里还会继续变熟，炒到全干就老了。"},

{"id":"we18","name":"燕麦隔夜杯","en":"Overnight Oats","cuisine":"西餐","type":"早餐","time":5,"level":1,"serves":1,"tags":["早餐","免开火","健康","带饭"],
"ing":[
{"n":"传统燕麦片","q":0.5,"u":"杯","g":"主料","buy":"old-fashioned rolled oats"},
{"n":"牛奶或燕麦奶","q":120,"u":"毫升","g":"主料","buy":"milk"},
{"n":"希腊酸奶","q":60,"u":"克","g":"配料","buy":"plain Greek yogurt"},
{"n":"奇亚籽","q":1,"u":"汤匙","g":"配料","buy":"chia seeds"},
{"n":"蜂蜜或枫糖浆","q":1,"u":"汤匙","g":"调料","buy":"honey"},
{"n":"肉桂粉","q":0,"u":"少许","g":"调料","buy":"ground cinnamon"},
{"n":"浆果或香蕉","q":0.5,"u":"杯","g":"配料","buy":"frozen mixed berries"}],
"steps":[
{"t":"玻璃罐或带盖杯子中放入燕麦、奶、希腊酸奶、奇亚籽、蜂蜜和肉桂粉。"},
{"t":"盖上盖子用力摇匀，或用勺子搅拌到没有干燕麦。"},
{"t":"放入冰箱冷藏至少 6 小时或过夜。","s":21600},
{"t":"早上取出搅一搅，太稠就加一点奶，铺上水果直接吃。"}],
"tip":"一次做 4–5 罐可冷藏 4 天；要用 old-fashioned 燕麦，即食燕麦泡完会烂成糊。"},

{"id":"we19","name":"烤什锦蔬菜","en":"Sheet-Pan Roasted Vegetables","cuisine":"西餐","type":"凉菜","time":35,"level":1,"serves":3,"tags":["素食","健康","烤箱"],
"ing":[
{"n":"西兰花","q":300,"u":"克","g":"主料","buy":"broccoli crowns"},
{"n":"甜椒","q":1,"u":"个","g":"主料","buy":"bell pepper"},
{"n":"西葫芦","q":1,"u":"根","g":"主料","buy":"zucchini"},
{"n":"胡萝卜","q":2,"u":"根","g":"主料","buy":"carrots"},
{"n":"红洋葱","q":1,"u":"个","g":"配料","buy":"red onion"},
{"n":"橄榄油","q":3,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"蒜粉","q":1,"u":"茶匙","g":"调料","buy":"garlic powder"},
{"n":"意式香草","q":1,"u":"茶匙","g":"调料","buy":"Italian seasoning"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0.5,"u":"茶匙","g":"调料","buy":"black pepper"},
{"n":"香醋（可选）","q":1,"u":"汤匙","g":"调料","buy":"balsamic vinegar"}],
"steps":[
{"t":"烤箱预热到 425°F / 220°C。"},
{"t":"蔬菜切成大小差不多的块：西兰花分小朵，胡萝卜斜切厚片（切薄一点因为熟得慢），甜椒、西葫芦、洋葱切块。"},
{"t":"所有蔬菜加橄榄油和调料拌匀，平铺在一个或两个烤盘上，不要堆叠，否则会变成蒸。"},
{"t":"烤 12 分钟后翻面，再烤 10–12 分钟至边缘焦黄。","s":1440},
{"t":"出炉趁热淋一点香醋，可当配菜，也可拌意面或放进饭盒。"}],
"tip":"烤盘越不挤越容易烤出焦糖色，Costco 的大袋西兰花和甜椒组合装很划算。"},

{"id":"we20","name":"三文鱼芦笋烤盘","en":"Sheet-Pan Salmon with Asparagus & Potatoes","cuisine":"西餐","type":"主菜","time":45,"level":1,"serves":2,"tags":["健康","烤箱","一盘出"],
"ing":[
{"n":"三文鱼排","q":340,"u":"克","g":"主料","buy":"Atlantic salmon fillets"},
{"n":"芦笋","q":1,"u":"把","g":"主料","buy":"asparagus"},
{"n":"小土豆","q":350,"u":"克","g":"主料","buy":"baby potatoes"},
{"n":"柠檬","q":1,"u":"个","g":"配料","buy":"lemon"},
{"n":"大蒜","q":2,"u":"瓣","g":"配料","buy":"garlic"},
{"n":"橄榄油","q":3,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"莳萝或欧芹","q":0,"u":"少许","g":"调料","buy":"fresh dill"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0.5,"u":"茶匙","g":"调料","buy":"black pepper"}],
"steps":[
{"t":"烤箱预热到 425°F / 220°C。小土豆对半切，加 1 汤匙橄榄油、盐和胡椒拌匀，平铺在烤盘上。"},
{"t":"先烤土豆 15 分钟。","s":900},
{"t":"同时芦笋折掉老根，拌少许油和盐；大蒜切末，与剩下的橄榄油、半个柠檬汁和盐胡椒混合。"},
{"t":"土豆翻面推到一边，空出位置放三文鱼（皮朝下）和芦笋，三文鱼表面刷蒜香柠檬油，铺几片柠檬。"},
{"t":"继续烤 12–14 分钟，至三文鱼能用叉子轻松拨开成片，中心达到 145°F / 63°C。","s":780},
{"t":"撒莳萝或欧芹，挤上剩下的柠檬汁，直接端烤盘上桌。"}],
"tip":"Costco 的大西洋三文鱼整片买回家切块分装冷冻，前一晚放冰箱解冻即可。"},

{"id":"we21","name":"奶香土豆泥","en":"Creamy Mashed Potatoes","cuisine":"西餐","type":"主食","time":35,"level":1,"serves":4,"tags":["经典","配菜"],
"ing":[
{"n":"黄心土豆","q":900,"u":"克","g":"主料","buy":"Yukon Gold potatoes"},
{"n":"黄油","q":60,"u":"克","g":"配料","buy":"butter"},
{"n":"牛奶","q":120,"u":"毫升","g":"配料","buy":"whole milk"},
{"n":"酸奶油（可选）","q":2,"u":"汤匙","g":"配料","buy":"sour cream"},
{"n":"盐","q":1,"u":"茶匙","g":"调料","buy":"kosher salt"},
{"n":"黑胡椒","q":0,"u":"适量","g":"调料","buy":"black pepper"},
{"n":"香葱","q":0,"u":"少许","g":"配料","buy":"chives"}],
"steps":[
{"t":"土豆去皮切成约 4 厘米的均匀大块，放入锅中加冷水没过，加一大撮盐。"},
{"t":"大火煮开后转中火煮 15–18 分钟，用筷子能轻松戳穿即可。","s":1020},
{"t":"同时把牛奶和黄油一起小火加热到黄油融化，不要煮沸。"},
{"t":"土豆沥干后倒回锅里，开小火 1 分钟让多余水分蒸发。"},
{"t":"用压泥器或叉子压成泥（不要用搅拌机，会变成胶状），分次拌入热牛奶黄油和酸奶油。"},
{"t":"加盐和黑胡椒调味，撒葱花，中间放一小块黄油上桌。"}],
"tip":"冷水下锅土豆受热才均匀；加的奶一定要是热的，冷奶会让土豆泥变黏发凉。"},

{"id":"we22","name":"浓郁布朗尼","en":"Fudgy Brownies","cuisine":"西餐","type":"甜点","time":45,"level":2,"serves":9,"tags":["烘焙","甜"],
"ing":[
{"n":"无盐黄油","q":113,"u":"克","g":"主料","buy":"unsalted butter (1 stick)"},
{"n":"白糖","q":200,"u":"克","g":"主料","buy":"granulated sugar"},
{"n":"鸡蛋","q":2,"u":"个","g":"主料","buy":"large eggs"},
{"n":"无糖可可粉","q":40,"u":"克","g":"主料","buy":"unsweetened cocoa powder"},
{"n":"中筋面粉","q":65,"u":"克","g":"主料","buy":"all-purpose flour"},
{"n":"巧克力豆","q":80,"u":"克","g":"配料","buy":"semi-sweet chocolate chips"},
{"n":"香草精","q":1,"u":"茶匙","g":"调料","buy":"vanilla extract"},
{"n":"盐","q":0.25,"u":"茶匙","g":"调料","buy":"salt"}],
"steps":[
{"t":"烤箱预热到 350°F / 175°C，8×8 英寸方形烤盘铺烘焙纸，两边留出可提起的边。"},
{"t":"黄油微波或小火融化，趁热加入白糖搅匀，再加入可可粉、盐和香草精拌成浓稠的巧克力糊。"},
{"t":"稍凉后逐个加入鸡蛋，每加一个都用力搅拌 30 秒，直到面糊变亮有光泽。"},
{"t":"筛入面粉，用刮刀轻轻翻拌到没有干粉，拌入一半巧克力豆。"},
{"t":"倒入烤盘抹平，撒上剩下的巧克力豆，烤 22–26 分钟，牙签插入中间带出少量湿润碎屑即可。","s":1440},
{"t":"在烤盘里完全放凉至少 1 小时再切块，否则会散。","s":3600}],
"tip":"宁可少烤一点不要多烤，布朗尼出炉后还会继续凝固，烤过头就变成蛋糕了。"},

{"id":"we23","name":"香蕉面包","en":"Banana Bread","cuisine":"西餐","type":"甜点","time":75,"level":1,"serves":8,"tags":["烘焙","早餐"],
"ing":[
{"n":"熟透的香蕉","q":3,"u":"根","g":"主料","buy":"ripe bananas"},
{"n":"中筋面粉","q":190,"u":"克","g":"主料","buy":"all-purpose flour"},
{"n":"红糖","q":100,"u":"克","g":"主料","buy":"light brown sugar"},
{"n":"鸡蛋","q":1,"u":"个","g":"主料","buy":"large eggs"},
{"n":"融化黄油","q":75,"u":"克","g":"配料","buy":"unsalted butter"},
{"n":"小苏打","q":1,"u":"茶匙","g":"调料","buy":"baking soda"},
{"n":"盐","q":0.25,"u":"茶匙","g":"调料","buy":"salt"},
{"n":"香草精","q":1,"u":"茶匙","g":"调料","buy":"vanilla extract"},
{"n":"肉桂粉","q":0.5,"u":"茶匙","g":"调料","buy":"ground cinnamon"},
{"n":"核桃碎（可选）","q":50,"u":"克","g":"配料","buy":"chopped walnuts"}],
"steps":[
{"t":"烤箱预热到 350°F / 175°C，9×5 英寸吐司模抹油或铺烘焙纸。"},
{"t":"香蕉放大碗中用叉子压成泥，加入融化黄油搅匀。"},
{"t":"加入红糖、鸡蛋和香草精搅匀。"},
{"t":"撒入小苏打、盐和肉桂粉拌匀，再加入面粉，用刮刀翻拌到刚好没有干粉，拌入核桃。"},
{"t":"倒入模具，烤 55–60 分钟，牙签插入中心拔出干净即可；表面上色太快可盖一张锡纸。","s":3420},
{"t":"在模具里放凉 10 分钟后脱模，放在架子上完全晾凉再切。","s":600}],
"tip":"香蕉越黑越甜越香；Walmart 常有打折的熟香蕉，买回来剥皮冷冻，攒够 3 根就能做。"},

{"id":"we24","name":"家常意式披萨","en":"Easy Homemade Pizza (Store-Bought Dough)","cuisine":"西餐","type":"主食","time":40,"level":1,"serves":2,"tags":["意式","聚会"],
"ing":[
{"n":"现成披萨面团","q":450,"u":"克","g":"主料","buy":"refrigerated pizza dough"},
{"n":"披萨酱或番茄酱汁","q":120,"u":"毫升","g":"配料","buy":"pizza sauce"},
{"n":"马苏里拉芝士丝","q":200,"u":"克","g":"主料","buy":"shredded low-moisture mozzarella"},
{"n":"意式辣香肠片","q":60,"u":"克","g":"配料","buy":"pepperoni"},
{"n":"蘑菇或甜椒","q":0,"u":"适量","g":"配料","buy":"mushrooms, bell pepper"},
{"n":"橄榄油","q":1,"u":"汤匙","g":"调料","buy":"olive oil"},
{"n":"玉米粉或面粉（防粘）","q":1,"u":"汤匙","g":"调料","buy":"cornmeal"},
{"n":"干牛至、辣椒碎","q":0,"u":"少许","g":"调料","buy":"dried oregano, red pepper flakes"},
{"n":"帕玛森芝士粉","q":0,"u":"少许","g":"调料","buy":"grated parmesan"}],
"steps":[
{"t":"面团提前 30 分钟从冰箱取出回温，盖保鲜膜防干，回温后更好擀开。","s":1800},
{"t":"烤箱放最低层，预热到 475°F / 245°C，有披萨石或铸铁锅就一起预热。"},
{"t":"烤盘刷油撒玉米粉，面团用手指按压、推开成约 30 厘米的圆饼，边缘留厚一点。"},
{"t":"薄薄抹一层酱（太多会湿软），撒芝士，铺上辣香肠和蔬菜，边缘刷少许橄榄油。"},
{"t":"烤 12–15 分钟，至饼边金黄、芝士冒泡带焦点。","s":780},
{"t":"出炉静置 2 分钟再切，撒牛至、辣椒碎和芝士粉。"}],
"tip":"Walmart 和 Food 4 Less 冷藏区或烘焙区都有现成面团；蔬菜含水多的话先炒一下再放，饼底不会湿。"}
]}
