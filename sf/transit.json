","c":"#9C6B3F","path":[[37.7848,-122.4078],[37.792,-122.4092],[37.7947,-122.4103],[37.7955,-122.4117],[37.8008,-122.4125],[37.804,-122.414],[37.8048,-122.4153]]},{"n":"叮当车 California","c":"#5C3A1E","path":[[37.7936,-122.3966],[37.792,-122.4092],[37.7915,-122.413],[37.7903,-122.422]]},{"n":"F 线复古电车","c":"#D35400","path":[[37.7626,-122.4351],[37.7672,-122.429],[37.7752,-122.4192],[37.7797,-122.414],[37.7844,-122.4079],[37.7894,-122.4013],[37.7929,-122.3971],[37.7955,-122.3937],[37.8005,-122.399],[37.806,-122.4045],[37.8087,-122.4098],[37.8075,-122.417]]}],"st":[{"id":"PM","ll":[37.7848,-122.4078],"en":"Powell & Market","zh":"叮当车起点（转盘）","big":true},{"id":"PC","ll":[37.792,-122.4092],"en":"Powell & California","zh":"两线交叉","big":true},{"id":"HL","ll":[37.8016,-122.4196],"en":"Hyde & Lombard","zh":"九曲花街顶上","big":true},{"id":"HB","ll":[37.8066,-122.4209],"en":"Hyde & Beach","zh":"Powell-Hyde 终点 · 近吉尔德利广场","big":true},{"id":"TB","ll":[37.8048,-122.4153],"en":"Taylor & Bay","zh":"Powell-Mason 终点 · 近渔人码头","big":true},{"id":"CD","ll":[37.7936,-122.3966],"en":"California & Drumm","zh":"California 线东端","big":true},{"id":"CV","ll":[37.7903,-122.422],"en":"California & Van Ness","zh":"California 线西端","big":true},{"id":"GC","ll":[37.7915,-122.413],"en":"California & Taylor","zh":"格雷斯大教堂 · 诺布山","big":true},{"id":"FCA","ll":[37.7626,-122.4351],"en":"17th & Castro","zh":"F 线西端","big":true},{"id":"FFB","ll":[37.7955,-122.3937],"en":"Ferry Building","zh":"渡轮大厦","big":true},{"id":"FP39","ll":[37.8087,-122.4098],"en":"Pier 39","zh":"海狮","big":true},{"id":"FFW","ll":[37.8075,-122.417],"en":"Jones & Beach","zh":"渔人码头 · F 线终点","big":true}]},{"k":"tips","n":"💡 用心提示","lines":[],"st":[],"tips":[{"ll":[37.7848,-122.4078],"e":"🔔","t":"叮当车起点：别在这排一小时","d":"Powell & Market 转盘排队的大多是游客。往北走两三个路口，在叮当车站牌招手就能上；或者改坐人少的 California 线。","w":0},{"ll":[37.6159,-122.3924],"e":"✈️","t":"SFO 机场进城","d":"坐 BART 到市中心大约 30 分钟，比打车便宜很多。SFO 站进出要加收机场附加费，所以票价比别的站贵一点；Clipper 卡、手机钱包都能刷。","w":0},{"ll":[37.7132,-122.2122],"e":"✈️","t":"奥克兰机场进城","d":"机场有无人驾驶的接驳列车连到 Coliseum 站，换 BART 进旧金山大约半小时。奥克兰机场的机票常常比 SFO 便宜。","w":0},{"ll":[37.7929,-122.3971],"e":"⛴️","t":"Embarcadero 出站就是渡轮大厦","d":"周二、四、六上午有农夫市集（周六最大）。这里也能坐渡轮去索萨利托、奥克兰、阿拉米达，船上看海湾大桥和恶魔岛。","w":0},{"ll":[37.7797,-122.414],"e":"⚠️","t":"市政中心一带晚上注意","d":"Civic Center 站和旁边的田德隆区，街上流浪者和毒品问题比较严重。白天正常走没事，晚上不熟就绕开，别在街上低头玩手机。","w":1},{"ll":[37.765,-122.4197],"e":"⚠️","t":"16 街站出口注意","d":"16th St Mission 站出口的小广场比较乱，看好手机和包。往西走一个街区到 Valencia St 就是咖啡馆和书店。","w":1},{"ll":[37.789,-122.4021],"e":"💳","t":"Market St 是两层地铁","d":"Civic Center 到 Embarcadero 这四个站，上层是 Muni 轻轨，下层是 BART，进站时看清楚标志。Clipper 卡两边通用；Muni 车票 120 分钟内免费换乘。","w":0},{"ll":[37.7215,-122.4475],"e":"🔁","t":"Balboa Park 换乘","d":"BART 和 J、K、M 三条轻轨在这里换乘，城市学院就在旁边。","w":0},{"ll":[37.6002,-122.3866],"e":"🚆","t":"Millbrae 换 Caltrain","d":"去硅谷、斯坦福、圣何塞，在这里从 BART 换 Caltrain，同一个站台楼。","w":0},{"ll":[37.7764,-122.3943],"e":"🚆","t":"Caltrain 起点站","d":"4th & King 是 Caltrain 在旧金山的起点，去硅谷、圣何塞。N 线和 T 线都到这里。","w":0},{"ll":[37.7795,-122.3897],"e":"⚾","t":"巨人队主场","d":"甲骨文球场就在 2nd & King 站旁边。比赛日 N 线、T 线挤得上不去，提前一小时出发，或者沿海边走过去。","w":0},{"ll":[37.7686,-122.3893],"e":"🏀","t":"勇士队主场","d":"大通中心（Chase Center）坐 T 线到 UCSF/Chase Center 站下车就是。","w":0},{"ll":[37.7948,-122.4078],"e":"🏮","t":"唐人街站很深","d":"中央地铁唐人街站在地下很深的地方，坐扶梯上下要好一会儿。出站就是 Stockton St，本地华人买菜的街。","w":0},{"ll":[37.7603,-122.509],"e":"🌅","t":"N 线终点：海洋海滩","d":"坐 N Judah 到底就是太平洋，适合看日落。这里的海水冷、浪大、离岸流危险，不建议下水。风很大，带外套。","w":0},{"ll":[37.7694,-122.4862],"e":"🌳","t":"去金门公园","d":"N 线、5 路、7 路、44 路都能到。公园中间的 JFK 大道不让车开，适合散步、骑车；德扬美术馆顶楼观景塔免费。","w":0},{"ll":[37.8077,-122.475],"e":"🌉","t":"去金门大桥","d":"28 路巴士在桥南端收费站附近有站。桥上风大、很冷，再热的天也带外套；走一趟单程约 30–40 分钟。","w":0},{"ll":[37.8021,-122.4187],"e":"📸","t":"九曲花街 Lombard St","d":"坐 Powell-Hyde 叮当车，在 Lombard St 下车，从上往下走着拍最好看。别开车排队下坡，常常要等很久。","w":0},{"ll":[37.8085,-122.4037],"e":"🔒","t":"去恶魔岛坐船的码头","d":"恶魔岛的船只从 Pier 33 出发，只在官网 alcatrazcitycruises.com 买票，常常提前几周卖光。F 线在门口有站。","w":0},{"ll":[37.8075,-122.417],"e":"🚗","t":"渔人码头：车里什么都别留","d":"这一带是砸车窗最多的地方之一。停车后车里连空袋子、充电线都别露出来。F 线电车终点就在这里。","w":1},{"ll":[37.7596,-122.4269],"e":"☀️","t":"多洛雷斯公园","d":"J 线在 Church & 18th 下车就是。这里常常别处起雾、这里出太阳，周末满草地都是野餐的人。","w":0},{"ll":[37.7764,-122.433],"e":"🏠","t":"彩绘女士","d":"坐 5 路或 21 路到阿拉莫广场附近。这一带和双子峰的停车场砸车窗很常见，车里别留东西。","w":1},{"ll":[37.7544,-122.4477],"e":"⛰️","t":"双子峰：没有轨道交通","d":"可以坐 37 路巴士到附近再爬一段，或者开车上山顶停车场。傍晚风大很冷。","w":0},{"ll":[37.8024,-122.4058],"e":"🎨","t":"科伊特塔","d":"39 路小巴士开到塔下。也可以从北滩爬 Filbert Steps 上去，沿途有花园和野生鹦鹉。","w":0},{"ll":[37.7799,-122.511],"e":"🌊","t":"Lands End 和苏特罗浴场","d":"坐 38 路往西到终点附近，走海崖步道到浴场遗址，能看到金门大桥的背面。","w":0},{"ll":[37.7895,-122.3965],"e":"🚡","t":"Salesforce 公交中心","d":"很多巴士的市区终点在这里。楼顶有一座免费的空中公园，Fremont 和 Mission 路口有免费小缆车上去。","w":0},{"ll":[37.7973,-122.2655],"e":"🥟","t":"奥克兰唐人街","d":"Lake Merritt 站出来走几分钟就是奥克兰唐人街，比旧金山唐人街游客少，吃的也便宜。","w":0},{"ll":[37.87,-122.2681],"e":"🎓","t":"加州大学伯克利","d":"Downtown Berkeley 站出站往东走几分钟就是校园，可以上萨瑟塔（钟楼）看海湾。","w":0},{"ll":[37.8049,-122.2951],"e":"🚢","t":"奥克兰港就在旁边","d":"West Oakland 站旁边就是奥克兰港的集装箱码头，从 BART 车窗能看到成排的岸桥吊车。这是北加州进出口柜子的主要门户。","w":0},{"ll":[37.8029,-122.4484],"e":"🏛️","t":"艺术宫","d":"1915 年世博会留下的罗马式圆顶，湖边有天鹅，免费。傍晚灯亮了很好看。30 路巴士到码头区再走几分钟。","w":0},{"ll":[37.8105,-122.4772],"e":"🏰","t":"Fort Point：站在大桥正下方","d":"南北战争时期的砖砌堡垒，就在金门大桥南端的正下方，仰拍桥身最震撼。开放时间有限，去之前查一下；外面的海堤随时能去。","w":0},{"ll":[37.8277,-122.4836],"e":"📸","t":"Battery Spencer：明信片机位","d":"大桥北端山坡上的老炮台，从高处拍整座桥和后面的城市，最经典的角度。停车位很少，早上或傍晚去，起雾时可能什么都看不见。","w":0},{"ll":[37.7936,-122.4836],"e":"🏖️","t":"Baker Beach","d":"沙滩上拍金门大桥和海浪。海水冷、离岸流危险，不适合游泳。提醒一下：海滩北头是天体区。","w":0},{"ll":[37.8059,-122.4229],"e":"🍫","t":"吉尔德利广场","d":"老巧克力厂改的广场，门口能领免费巧克力小样。就在 Powell-Hyde 叮当车终点旁边。","w":0},{"ll":[37.8086,-122.422],"e":"⛵","t":"Hyde Street Pier 老帆船","d":"国家公园管理的历史船只码头，能上 1886 年的三桅帆船参观。","w":0},{"ll":[37.8094,-122.4157],"e":"🕹️","t":"Musée Mécanique","d":"免费入场的古董投币游戏机博物馆，带一把 25 美分硬币。门口那个怪笑的胖女人玩偶吓哭过好几代孩子。","w":0},{"ll":[37.8095,-122.4085],"e":"🦭","t":"海狮在 39 号码头西边","d":"海狮趴在 Pier 39 西侧的浮台上，冬天最多。味道和叫声都很大，哈哈。","w":0},{"ll":[37.8086,-122.4398],"e":"🎵","t":"海风琴 Wave Organ","d":"码头区防波堤尽头，海浪推动管子发声。涨潮时声音最明显，先查好潮汐。","w":0},{"ll":[37.8034,-122.4628],"e":"🌿","t":"Presidio Tunnel Tops","d":"盖在隧道上面的新公园，草坡正对金门大桥和恶魔岛，免费，孩子很爱的探险区。坐免费的 PresidiGo 班车。","w":0},{"ll":[37.7845,-122.5008],"e":"🖼️","t":"荣勒宫美术馆","d":"海边山顶上的法式美术馆，罗丹的《思想者》在门口。湾区居民周六免费。","w":0},{"ll":[37.788,-122.4075],"e":"🛍️","t":"联合广场","d":"购物中心地带，冬天有溜冰场和大圣诞树。人多，注意扒手。","w":0},{"ll":[37.7838,-122.414],"e":"⚠️","t":"田德隆区","d":"联合广场和市政厅之间这一片街上比较乱，白天正常走路，晚上不熟就绕开。","w":1},{"ll":[37.7851,-122.4294],"e":"🏯","t":"日本町","d":"和平塔、日式文具店、拉面、和果子。冷的时候去 Kabuki 温泉暖一暖。38 路巴士直达。","w":0},{"ll":[37.77,-122.4469],"e":"☮️","t":"海特-黑什伯里","d":"嬉皮街：二手唱片店 Amoeba（以前是保龄球馆）、古着店。7 路巴士，或 N 线到 Carl & Cole 走过去。","w":0},{"ll":[37.7609,-122.435],"e":"🏳️‍🌈","t":"卡斯特罗","d":"地上是彩虹斑马线，街口巨大的彩虹旗。卡斯特罗剧院是 1922 年的老电影院。Muni 轻轨 Castro 站出来就是。","w":0},{"ll":[37.7432,-122.4148],"e":"🎠","t":"Bernal Heights 秋千","d":"山顶有一棵树上挂着秋千，荡出去就是整个旧金山，比双子峰人少。","w":0},{"ll":[37.7563,-122.4732],"e":"🌈","t":"16th Avenue 马赛克阶梯","d":"163 级台阶拼满了马赛克，从海洋一路拼到天空。在住宅区里，拍照小声一点。注意是 16th Avenue，不是 16th Street。","w":0},{"ll":[37.7509,-122.4181],"e":"🌯","t":"米慎卷饼","d":"24th St BART 站出来走两分钟就有好几家老牌卷饼店。La Taqueria 的默认不放米。","w":0},{"ll":[37.7642,-122.4271],"e":"⛪","t":"多洛雷斯教堂","d":"1791 年建成，全城现存最老的建筑。隔壁小墓园里埋着旧金山的第一批开拓者。","w":0},{"ll":[37.7638,-122.472],"e":"🧋","t":"日落区 Irving St","d":"华人生活街：奶茶、粤菜、川菜、华人超市。N 线到 9th Ave & Irving 附近。","w":0},{"ll":[37.7826,-122.4648],"e":"🥟","t":"列治文区 Clement St","d":"人称「新唐人街」：点心、缅甸茶叶沙拉、港式烧腊，比唐人街更像本地人吃饭的地方。1 路、38 路巴士。","w":0},{"ll":[37.7919,-122.4134],"e":"🌀","t":"格雷斯大教堂的迷宫","d":"诺布山上的哥特式大教堂，室内室外各有一个可以走的冥想迷宫。坐叮当车 California 线到门口。","w":0},{"ll":[37.7946,-122.4115],"e":"⚙️","t":"叮当车博物馆","d":"免费。能看到地下拉着整套叮当车跑的巨大钢缆轮，轰隆隆地转。","w":0},{"ll":[37.8017,-122.3973],"e":"🔬","t":"探索馆","d":"Pier 15，上百个能动手玩的科学装置。每周四晚上有只限成人（18+）的夜场。F 线到门口。","w":0},{"ll":[37.7907,-122.3895],"e":"✨","t":"海湾大桥灯光","d":"天黑后桥上的 LED 灯会变幻图案。Rincon Park 那个大弓箭雕塑旁边看得最清楚。","w":0},{"ll":[37.8235,-122.3706],"e":"🌃","t":"金银岛看夜景","d":"海湾中间的人工岛，回头看旧金山天际线是全湾最好的角度之一。25 路巴士或开车过海湾大桥。","w":0},{"ll":[37.733,-122.503],"e":"🦒","t":"旧金山动物园","d":"L 线 Taraval 坐到底就是。旁边就是海洋海滩。","w":0},{"ll":[37.8564,-122.4777],"e":"🏘️","t":"索萨利托","d":"渡轮码头一下船就是小镇主街，往北走能看到船屋社区。回程的渡轮傍晚最挤，查好末班。","w":0},{"ll":[37.8608,-122.4326],"e":"✍️","t":"天使岛移民站","d":"当年关押华人的木屋墙上，刻着两百多首思乡的诗。坐渡轮上岛，移民站开放时间有限，先查官网。","w":0},{"ll":[37.897,-122.5811],"e":"🌲","t":"缪尔红杉林","d":"开车停车和坐接驳车都要提前在官网预约，没预约到了也进不去。山里信号差，提前下载好地图。","w":0},{"ll":[37.803,-122.4022],"e":"👖","t":"李维斯总部","d":"牛仔裤的诞生公司，总部大厦一楼有小展览和定制店。旁边的 Levi's Plaza 很适合坐一会儿。","w":0}]},{"k":"bus","n":"🚌 主要巴士","lines":[{"n":"38 Geary","c":"#C0392B","d":"市中心 ⇄ 列治文区海边（有 38R 快线）","no":"38","path":[[37.7895,-122.3965],[37.787,-122.407],[37.783,-122.447],[37.78,-122.493],[37.78,-122.509]]},{"n":"1 California","c":"#2E86C1","d":"金融区 ⇄ 唐人街 ⇄ 列治文区","no":"1","path":[[37.795,-122.397],[37.79,-122.433],[37.788,-122.447],[37.784,-122.493]]},{"n":"5 Fulton","c":"#16A085","d":"市中心 ⇄ 金门公园北边 ⇄ 海洋海滩（有 5R）","no":"5","path":[[37.7895,-122.3965],[37.78,-122.418],[37.776,-122.447],[37.773,-122.51]]},{"n":"7 Haight-Noriega","c":"#8E44AD","d":"市中心 ⇄ 海特街 ⇄ 日落区","no":"7","path":[[37.791,-122.396],[37.776,-122.418],[37.771,-122.433],[37.769,-122.453],[37.762,-122.47],[37.754,-122.507]]},{"n":"14 Mission","c":"#D35400","d":"市中心 ⇄ 米慎区 ⇄ 戴利城（有 14R）","no":"14","path":[[37.7895,-122.3965],[37.776,-122.413],[37.765,-122.419],[37.749,-122.418],[37.724,-122.433],[37.706,-122.448]]},{"n":"22 Fillmore","c":"#27AE60","d":"码头区 ⇄ 菲尔莫尔街 ⇄ 16 街 ⇄ 教会湾","no":"22","path":[[37.801,-122.436],[37.785,-122.433],[37.77,-122.432],[37.765,-122.42],[37.766,-122.391]]},{"n":"30 Stockton","c":"#F39C12","d":"Caltrain ⇄ 唐人街 ⇄ 北滩 ⇄ 码头区","no":"30","path":[[37.777,-122.395],[37.786,-122.406],[37.796,-122.407],[37.803,-122.41],[37.802,-122.441]]},{"n":"8 Bayshore","c":"#7F8C8D","d":"渔人码头 ⇄ 唐人街 ⇄ 访谷区","no":"8","path":[[37.806,-122.416],[37.795,-122.405],[37.784,-122.403],[37.76,-122.405],[37.735,-122.402],[37.711,-122.404]]},{"n":"28 19th Ave","c":"#1F618D","d":"Fort Mason ⇄ 金门大桥 ⇄ 19 大道 ⇄ 戴利城 BART","no":"28","path":[[37.805,-122.43],[37.8,-122.449],[37.805,-122.476],[37.785,-122.477],[37.745,-122.476],[37.722,-122.475],[37.706,-122.469]]},{"n":"49 Van Ness-Mission","c":"#A04000","d":"Fort Mason ⇄ 范尼斯大道 ⇄ 米慎区 ⇄ 城市学院","no":"49","path":[[37.806,-122.424],[37.775,-122.424],[37.765,-122.419],[37.749,-122.418],[37.728,-122.44],[37.722,-122.452]]},{"n":"29 Sunset","c":"#B7950B","d":"要塞 ⇄ 日落大道 ⇄ 巴尔博亚公园 ⇄ 湾景区","no":"29","path":[[37.796,-122.477],[37.776,-122.494],[37.745,-122.494],[37.727,-122.482],[37.722,-122.448],[37.722,-122.395]]},{"n":"24 Divisadero","c":"#5D6D7E","d":"太平洋高地 ⇄ 迪维萨德罗街 ⇄ 诺伊谷","no":"24","path":[[37.791,-122.441],[37.77,-122.439],[37.755,-122.435],[37.751,-122.42]]}],"st":[]}]}