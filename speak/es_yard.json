{
 "packs": [
  {
   "id": "es-saludos",
   "name": "打招呼和客气话",
   "icon": "👋",
   "group": "西语",
   "lang": "es-MX",
   "intro": "每天在场子里见面先打个招呼，关系就好处。墨西哥同事最常用 ¿Qué onda? 和 ¿Qué tal?，记住 con permiso 和 gracias 走遍天下。",
   "dialog": [
    {
     "who": "Driver",
     "t": "¡Buenos días! ¿Qué onda?",
     "zh": "早上好！咋样？"
    },
    {
     "who": "You",
     "t": "Buenos días. Todo bien, ¿y tú?",
     "zh": "早上好。都挺好，你呢？"
    },
    {
     "who": "Driver",
     "t": "Aquí nomás, trabajando.",
     "zh": "就这样，干活呗。"
    },
    {
     "who": "You",
     "t": "¿Cómo te llamas?",
     "zh": "你叫什么名字？"
    },
    {
     "who": "Driver",
     "t": "Me llamo Luis. ¿Y tú?",
     "zh": "我叫 Luis。你呢？"
    },
    {
     "who": "You",
     "t": "Me llamo Steve. Mucho gusto.",
     "zh": "我叫 Steve。很高兴认识你。"
    },
    {
     "who": "Driver",
     "t": "Igualmente. Gracias por la ayuda.",
     "zh": "我也是。谢谢你帮忙。"
    },
    {
     "who": "You",
     "t": "De nada. Que te vaya bien.",
     "zh": "不客气。一路顺风。"
    }
   ],
   "phrases": [
    {
     "t": "¿Qué onda?",
     "zh": "怎么样？/嘿，咋样？",
     "note": "墨西哥口语，熟人之间最常见的打招呼；回答可以说 Todo bien 或 Aquí nomás。"
    },
    {
     "t": "¿Cómo estás?",
     "zh": "你好吗？",
     "note": "标准问候，对谁都可以用。"
    },
    {
     "t": "Buenos días.",
     "zh": "早上好。",
     "note": "中午12点前用；下午说 Buenas tardes，晚上说 Buenas noches。"
    },
    {
     "t": "Buenas tardes, ¿cómo le va?",
     "zh": "下午好，您最近怎么样？",
     "note": "用 le 是尊称（usted），对年长司机或主管更客气。"
    },
    {
     "t": "Todo bien, gracias. ¿Y tú?",
     "zh": "都挺好，谢谢。你呢？"
    },
    {
     "t": "Aquí nomás, trabajando.",
     "zh": "就这样呗，干活呢。",
     "note": "墨西哥口语，nomás = 只是、就；非常地道的回答。"
    },
    {
     "t": "Muchas gracias.",
     "zh": "非常感谢。"
    },
    {
     "t": "De nada.",
     "zh": "不客气。",
     "note": "也常听到 Por nada 或 No hay de qué。"
    },
    {
     "t": "Con permiso.",
     "zh": "借过/打扰一下。",
     "note": "从别人身边走过或打断别人时说；对方会回 Pásale 或 Propio。"
    },
    {
     "t": "Pásale.",
     "zh": "请进/请过。",
     "note": "墨西哥口语，请人进来或先走。"
    },
    {
     "t": "Perdón, no te entendí.",
     "zh": "抱歉，我没听懂。"
    },
    {
     "t": "¿Me lo repites, por favor?",
     "zh": "请你再说一遍好吗？"
    },
    {
     "t": "Más despacio, por favor.",
     "zh": "请说慢一点。",
     "note": "跟语速快的司机沟通非常有用。"
    },
    {
     "t": "Buen trabajo, compa.",
     "zh": "干得好，哥们。",
     "note": "compa = compañero/compadre，墨西哥男同事之间的亲切称呼。"
    },
    {
     "t": "¿Cómo te llamas?",
     "zh": "你叫什么名字？"
    },
    {
     "t": "Mucho gusto. Me llamo Steve.",
     "zh": "很高兴认识你。我叫 Steve。",
     "note": "可以把名字换成你自己的。"
    },
    {
     "t": "Que te vaya bien.",
     "zh": "祝你顺利/一路顺风。",
     "note": "跟司机道别时很自然。"
    }
   ]
  },
  {
   "id": "es-reversa",
   "name": "指挥倒车和停车",
   "icon": "🚛",
   "group": "西语",
   "lang": "es-MX",
   "intro": "帮司机倒车进门或停到车位时，声音要大、词要短。墨西哥司机常说 la troca（卡车，Spanglish），倒车用 reversa 或 para atrás。",
   "dialog": [
    {
     "who": "Driver",
     "t": "¿En qué puerta lo meto?",
     "zh": "我倒进哪个门？"
    },
    {
     "who": "You",
     "t": "En la puerta cinco. Dale reversa.",
     "zh": "五号门。倒吧。"
    },
    {
     "who": "You",
     "t": "Atrás, atrás, sigue.",
     "zh": "往后，往后，继续。"
    },
    {
     "who": "You",
     "t": "Gira a la derecha, un poquito.",
     "zh": "往右打一点点。"
    },
    {
     "who": "Driver",
     "t": "¿Así está bien?",
     "zh": "这样行吗？"
    },
    {
     "who": "You",
     "t": "Despacio, te falta un poco.",
     "zh": "慢点，还差一点。"
    },
    {
     "who": "You",
     "t": "¡Para! Ya quedó.",
     "zh": "停！好了。"
    },
    {
     "who": "Driver",
     "t": "Gracias, compa.",
     "zh": "谢了，哥们。"
    }
   ],
   "phrases": [
    {
     "t": "Atrás, atrás, sigue.",
     "zh": "往后，往后，继续。",
     "note": "sigue = 继续，不停地喊让司机知道还能倒。"
    },
    {
     "t": "¡Para! ¡Para ahí!",
     "zh": "停！停在那儿！",
     "note": "也可以说 ¡Alto! 或 ¡Ya, ya!。"
    },
    {
     "t": "Ya quedó.",
     "zh": "好了/到位了。",
     "note": "墨西哥口语，表示停好了、搞定了。"
    },
    {
     "t": "Un poquito más.",
     "zh": "再一点点。"
    },
    {
     "t": "Despacio, despacio.",
     "zh": "慢点，慢点。"
    },
    {
     "t": "Gira a la derecha.",
     "zh": "往右打。",
     "note": "也可以只说 A la derecha。"
    },
    {
     "t": "Gira a la izquierda.",
     "zh": "往左打。"
    },
    {
     "t": "Endereza las llantas.",
     "zh": "把轮子回正。",
     "note": "llantas = 轮胎；enderezar = 弄直。"
    },
    {
     "t": "Dale reversa, despacito.",
     "zh": "慢慢倒车。",
     "note": "dale = 来吧/给它；despacito 比 despacio 更柔和。"
    },
    {
     "t": "Estás muy cerca del otro tráiler.",
     "zh": "你离另一个拖车太近了。"
    },
    {
     "t": "Te falta un poco, dale.",
     "zh": "还差一点，继续。"
    },
    {
     "t": "Mete el tráiler en la puerta cinco.",
     "zh": "把拖车倒进五号门。"
    },
    {
     "t": "Parquéate en el espacio veinte.",
     "zh": "停到二十号车位。",
     "note": "Spanglish：parquear/parquearse = 停车，标准说法是 estacionar。"
    },
    {
     "t": "Pon el freno de mano.",
     "zh": "拉手刹。"
    },
    {
     "t": "Baja las patas del tráiler.",
     "zh": "把拖车支腿放下来。",
     "note": "patas = 支腿（landing gear），口语说法。"
    },
    {
     "t": "Ya puedes desenganchar.",
     "zh": "现在可以摘挂了。",
     "note": "desenganchar = 摘挂（脱开拖车）。"
    },
    {
     "t": "Avánzale un poquito.",
     "zh": "往前挪一点。",
     "note": "avánzale 是墨西哥口语带 -le 的命令式，很常见。"
    },
    {
     "t": "Fíjate en el espejo.",
     "zh": "注意看后视镜。"
    }
   ]
  },
  {
   "id": "es-seguridad",
   "name": "安全用语",
   "icon": "🦺",
   "group": "西语",
   "lang": "es-MX",
   "intro": "场子里叉车和卡车多，安全喊话要第一时间听懂。墨西哥人喊 ¡Aguas! 就是“小心！”，听到要马上看四周。",
   "dialog": [
    {
     "who": "Coworker",
     "t": "¡Aguas! ¡Viene el montacargas!",
     "zh": "小心！叉车过来了！"
    },
    {
     "who": "You",
     "t": "Gracias. No lo vi.",
     "zh": "谢谢，我没看到。"
    },
    {
     "who": "Coworker",
     "t": "No pases por ahí, es peligroso.",
     "zh": "别从那儿过，危险。"
    },
    {
     "who": "You",
     "t": "Está bien. ¿Por dónde paso?",
     "zh": "好的。我从哪儿过？"
    },
    {
     "who": "Coworker",
     "t": "Quédate en la línea peatonal.",
     "zh": "走人行线里面。"
    },
    {
     "who": "Coworker",
     "t": "Y ponte el chaleco, compa.",
     "zh": "还有，把背心穿上，哥们。"
    },
    {
     "who": "You",
     "t": "Sí, ahorita me lo pongo.",
     "zh": "好，我马上穿。"
    }
   ],
   "phrases": [
    {
     "t": "¡Cuidado!",
     "zh": "小心！"
    },
    {
     "t": "¡Aguas!",
     "zh": "小心！注意！",
     "note": "墨西哥俚语，意思等于 ¡Cuidado!，喊危险时最常用；字面是“水”，在西班牙没人这么说。"
    },
    {
     "t": "¡Aguas con el montacargas!",
     "zh": "小心叉车！",
     "note": "montacargas = 叉车；也有人用 Spanglish 说 el forklift。"
    },
    {
     "t": "Ponte el chaleco.",
     "zh": "穿上反光背心。"
    },
    {
     "t": "Ponte el casco, por favor.",
     "zh": "请戴上安全帽。"
    },
    {
     "t": "No pases por ahí.",
     "zh": "别从那儿过。"
    },
    {
     "t": "Está pasando un camión.",
     "zh": "有卡车正在过。"
    },
    {
     "t": "Quédate en la línea peatonal.",
     "zh": "走人行线里面。",
     "note": "línea peatonal = 行人通道线。"
    },
    {
     "t": "No te pares detrás del tráiler.",
     "zh": "别站在拖车后面。"
    },
    {
     "t": "Hazte para un lado.",
     "zh": "往旁边让一让。",
     "note": "墨西哥口语，也说 Hazte a un lado。"
    },
    {
     "t": "El piso está mojado.",
     "zh": "地面是湿的。"
    },
    {
     "t": "Ponte los guantes.",
     "zh": "戴上手套。"
    },
    {
     "t": "Usa los lentes de seguridad.",
     "zh": "戴上护目镜。",
     "note": "墨西哥说 lentes，西班牙说 gafas。"
    },
    {
     "t": "Apaga el motor, por favor.",
     "zh": "请熄火。"
    },
    {
     "t": "Pon las calzas en las llantas.",
     "zh": "在轮子下面垫上轮挡。",
     "note": "calzas = 轮挡（wheel chocks）。"
    },
    {
     "t": "Mira para los dos lados.",
     "zh": "两边都看一下。"
    },
    {
     "t": "¿Estás bien? ¿Te lastimaste?",
     "zh": "你没事吧？受伤了吗？"
    },
    {
     "t": "Hay que reportar el accidente.",
     "zh": "得上报这个事故。"
    }
   ]
  },
  {
   "id": "es-numeros",
   "name": "柜号、数字和字母",
   "icon": "🔢",
   "group": "西语",
   "lang": "es-MX",
   "intro": "报柜号就是字母加数字一个一个念。先练 0–20 和整十，再练西语字母名（M 念 eme，S 念 ese），最后连起来念完整柜号。",
   "dialog": [
    {
     "who": "You",
     "t": "¿Cuál es el número del contenedor?",
     "zh": "柜号是多少？"
    },
    {
     "who": "Driver",
     "t": "Eme, ese, ce, u.",
     "zh": "M、S、C、U。"
    },
    {
     "who": "You",
     "t": "¿Y los números?",
     "zh": "数字呢？"
    },
    {
     "who": "Driver",
     "t": "Cuatro, cinco, ocho, dos, uno, cero.",
     "zh": "四、五、八、二、一、零。"
    },
    {
     "who": "Driver",
     "t": "Y el último es tres.",
     "zh": "最后一位是三。"
    },
    {
     "who": "You",
     "t": "¿Me lo repites número por número?",
     "zh": "能一个一个再说一遍吗？"
    },
    {
     "who": "Driver",
     "t": "Claro. Cuatro, cinco, ocho, dos, uno, cero, tres.",
     "zh": "当然。四五八二一零，三。"
    },
    {
     "who": "You",
     "t": "Perfecto, gracias.",
     "zh": "好的，谢谢。"
    }
   ],
   "phrases": [
    {
     "t": "Cero, uno, dos, tres, cuatro, cinco.",
     "zh": "零、一、二、三、四、五。"
    },
    {
     "t": "Seis, siete, ocho, nueve, diez.",
     "zh": "六、七、八、九、十。"
    },
    {
     "t": "Once, doce, trece, catorce, quince.",
     "zh": "十一、十二、十三、十四、十五。"
    },
    {
     "t": "Dieciséis, diecisiete, dieciocho, diecinueve, veinte.",
     "zh": "十六、十七、十八、十九、二十。"
    },
    {
     "t": "Treinta, cuarenta, cincuenta, sesenta.",
     "zh": "三十、四十、五十、六十。"
    },
    {
     "t": "Setenta, ochenta, noventa, cien.",
     "zh": "七十、八十、九十、一百。"
    },
    {
     "t": "A, be, ce, de, e, efe, ge.",
     "zh": "字母 A B C D E F G。",
     "note": "B 墨西哥人常说 be grande，V 说 ve chica，用来区分。"
    },
    {
     "t": "Hache, i, jota, ka, ele, eme, ene.",
     "zh": "字母 H I J K L M N。",
     "note": "H 念 hache，J 念 jota。"
    },
    {
     "t": "O, pe, cu, erre, ese, te, u.",
     "zh": "字母 O P Q R S T U。",
     "note": "Q 念 cu，R 念 erre。"
    },
    {
     "t": "Ve, doble u, equis, ye, zeta.",
     "zh": "字母 V W X Y Z。",
     "note": "W 在墨西哥念 doble u；Y 现在标准叫 ye，老一辈说 i griega。"
    },
    {
     "t": "¿Con be grande o con ve chica?",
     "zh": "是大 B 还是小 V？",
     "note": "西语 B 和 V 发音一样，确认字母时常这么问。"
    },
    {
     "t": "El número del contenedor es eme, ese, ce, u.",
     "zh": "柜号是 M、S、C、U。",
     "note": "四个字母是箱主代码，最后一个通常是 U。"
    },
    {
     "t": "Uno, dos, tres, cuatro, cinco, seis, y el siete.",
     "zh": "一二三四五六，最后是七。",
     "note": "最后一位是校验码，单独念，前面加 y。"
    },
    {
     "t": "¿Me lo puedes deletrear?",
     "zh": "你能拼一下吗？",
     "note": "deletrear = 一个一个字母拼。"
    },
    {
     "t": "¿Me lo repites número por número?",
     "zh": "能一个数字一个数字再说一遍吗？"
    },
    {
     "t": "Es la te de Tomás.",
     "zh": "是 Tomás 的 T。",
     "note": "用人名或地名区分字母，类似英文 T as in Tom。"
    },
    {
     "t": "El sello es el cuatro, cinco, ocho, dos.",
     "zh": "封条号是 4582。"
    },
    {
     "t": "La placa del camión termina en treinta y siete.",
     "zh": "卡车车牌尾号是三十七。"
    },
    {
     "t": "¿Cuál es el número del chasis?",
     "zh": "车架号是多少？",
     "note": "chasis = 底盘车架（集装箱拖架）。"
    }
   ]
  },
  {
