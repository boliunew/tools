  {
   "id": "es-prestar",
   "name": "借东西和请帮忙",
   "icon": "🔦",
   "group": "西语",
   "lang": "es-MX",
   "intro": "借工具、请人搭把手都用 ¿Me prestas…? 和 ¿Me ayudas…?。墨西哥人加个 tantito 或 un ratito 听起来更客气。",
   "dialog": [
    {
     "who": "You",
     "t": "Oye, ¿me prestas tu linterna?",
     "zh": "嘿，能借我你的手电吗？"
    },
    {
     "who": "Coworker",
     "t": "Sí, claro. Aquí tienes.",
     "zh": "当然，给你。"
    },
    {
     "who": "You",
     "t": "Gracias. ¿Tienes un sello nuevo?",
     "zh": "谢谢。你有新封条吗？"
    },
    {
     "who": "Coworker",
     "t": "No, pregunta en la oficina.",
     "zh": "没有，去办公室问问。"
    },
    {
     "who": "You",
     "t": "¿Me echas la mano con la puerta?",
     "zh": "帮我开一下柜门好吗？"
    },
    {
     "who": "Coworker",
     "t": "Va, ahorita voy.",
     "zh": "行，马上来。"
    },
    {
     "who": "You",
     "t": "Ahorita te regreso la linterna.",
     "zh": "我马上把手电还你。"
    },
    {
     "who": "Coworker",
     "t": "No hay problema.",
     "zh": "没问题。"
    }
   ],
   "phrases": [
    {
     "t": "¿Me prestas tu linterna?",
     "zh": "能借我你的手电吗？",
     "note": "墨西哥常说 linterna，也有人说 lámpara。"
    },
    {
     "t": "¿Me prestas una pluma?",
     "zh": "能借我支笔吗？",
     "note": "墨西哥说 pluma，西班牙说 bolígrafo。"
    },
    {
     "t": "¿Tienes un candado extra?",
     "zh": "你有多的锁吗？"
    },
    {
     "t": "Necesito un sello nuevo.",
     "zh": "我需要一个新的封条。"
    },
    {
     "t": "¿Me ayudas tantito?",
     "zh": "能帮我一下吗？",
     "note": "tantito = 一点点，墨西哥口语，很客气。"
    },
    {
     "t": "Ayúdame a abrir la puerta del contenedor.",
     "zh": "帮我开一下柜门。"
    },
    {
     "t": "¿Me echas la mano con esto?",
     "zh": "这个能帮我搭把手吗？",
     "note": "echar la mano = 帮忙，墨西哥口语。"
    },
    {
     "t": "¿Me pasas el radio?",
     "zh": "把对讲机递给我好吗？",
     "note": "墨西哥说 el radio（对讲机）。"
    },
    {
     "t": "¿Tienes cortador para el sello?",
     "zh": "你有剪封条的钳子吗？"
    },
    {
     "t": "Se me olvidó mi chaleco.",
     "zh": "我忘带背心了。"
    },
    {
     "t": "¿Dónde guardan las llaves?",
     "zh": "钥匙放在哪？"
    },
    {
     "t": "Ahorita te lo regreso.",
     "zh": "我马上还你。",
     "note": "ahorita 墨西哥意思是“马上/待会儿”，时间可长可短。"
    },
    {
     "t": "Gracias, te debo una.",
     "zh": "谢谢，欠你一个人情。"
    },
    {
     "t": "¿Me puedes cubrir un ratito?",
     "zh": "能帮我顶一会儿吗？"
    },
    {
     "t": "¿Me das un aventón a la oficina?",
     "zh": "能捎我到办公室吗？",
     "note": "aventón = 搭车，墨西哥说法；西班牙说 llevarme。"
    },
    {
     "t": "Sí, claro. Aquí tienes.",
     "zh": "当然，给你。"
    }
   ]
  },
  {
   "id": "es-descanso",
   "name": "休息和下班",
   "icon": "☕",
   "group": "西语",
   "lang": "es-MX",
   "intro": "午饭、休息、下班的聊天最容易拉近关系。墨西哥同事常直接用英文 el lunch、el break。",
   "dialog": [
    {
     "who": "Coworker",
     "t": "¿Ya te vas al lunch?",
     "zh": "你去吃午饭了吗？"
    },
    {
     "who": "You",
     "t": "Sí. ¿Qué trajiste de comer?",
     "zh": "对。你带了什么吃的？"
    },
    {
     "who": "Coworker",
     "t": "Nada. Vamos por unos tacos.",
     "zh": "啥也没带。咱们去吃塔可吧。"
    },
    {
     "who": "You",
     "t": "Va. ¿Cuánto dura el break?",
     "zh": "行。休息多久？"
    },
    {
     "who": "Coworker",
     "t": "Media hora nomás.",
     "zh": "就半小时。"
    },
    {
     "who": "You",
     "t": "¿Y a qué hora sales hoy?",
     "zh": "你今天几点下班？"
    },
    {
     "who": "Coworker",
     "t": "A las tres y media.",
     "zh": "三点半。"
    },
    {
     "who": "You",
     "t": "Órale, nos vemos al rato.",
     "zh": "好嘞，待会儿见。"
    }
   ],
   "phrases": [
    {
     "t": "¿Ya te vas al lunch?",
     "zh": "你要去吃午饭了吗？",
     "note": "Spanglish：el lunch，标准西语是 la comida/el almuerzo。"
    },
    {
     "t": "Me voy a tomar mi break.",
     "zh": "我去休息一下。",
     "note": "Spanglish：el break，标准说法 el descanso。"
    },
    {
     "t": "¿A qué hora sales hoy?",
     "zh": "你今天几点下班？"
    },
    {
     "t": "Salgo a las tres y media.",
     "zh": "我三点半下班。"
    },
    {
     "t": "¿Cuánto dura el break?",
     "zh": "休息多长时间？"
    },
    {
     "t": "Tenemos media hora para comer.",
     "zh": "我们有半小时吃饭。"
    },
    {
     "t": "¿Qué trajiste de comer?",
     "zh": "你带了什么吃的？"
    },
    {
     "t": "Vamos por unos tacos.",
     "zh": "我们去吃点塔可吧。"
    },
    {
     "t": "Ya casi es hora de salir.",
     "zh": "快到下班时间了。"
    },
    {
     "t": "¿Vas a trabajar el sábado?",
     "zh": "你周六上班吗？"
    },
    {
     "t": "Hoy me toca hacer horas extra.",
     "zh": "今天我要加班。",
     "note": "me toca = 轮到我/该我。"
    },
    {
     "t": "Ya ponché la salida.",
     "zh": "我已经打卡下班了。",
     "note": "Spanglish：ponchar = 打卡（punch）。"
    },
    {
     "t": "Nos vemos mañana.",
     "zh": "明天见。"
    },
    {
     "t": "Que descanses.",
     "zh": "好好休息。",
     "note": "下班道别时很暖心的一句。"
    },
    {
     "t": "Cuídate, nos vemos el lunes.",
     "zh": "保重，周一见。"
    },
    {
     "t": "Buen fin de semana.",
     "zh": "周末愉快。"
    }
   ]
  },
  {
   "id": "es-problemas",
   "name": "出问题了",
   "icon": "⚠️",
   "group": "西语",
   "lang": "es-MX",
   "intro": "柜子坏了、封条不对、车出问题时，要能说清楚哪里坏了，并且叫主管。关键词：dañado（损坏）、roto（破）、falta（缺）。",
   "dialog": [
    {
     "who": "Driver",
     "t": "Oye, falta el sello en este contenedor.",
     "zh": "喂，这个柜子封条没了。"
    },
    {
     "who": "You",
     "t": "A ver. Sí, es cierto.",
     "zh": "我看看。对，确实。"
    },
    {
     "who": "You",
     "t": "No lo muevas todavía.",
     "zh": "先别动它。"
    },
    {
     "who": "Driver",
     "t": "¿Y qué hago?",
     "zh": "那我怎么办？"
    },
    {
     "who": "You",
     "t": "Hay que tomarle fotos y llamar al supervisor.",
     "zh": "得拍照，然后叫主管。"
    },
    {
     "who": "Driver",
     "t": "Tengo prisa, compa.",
     "zh": "我赶时间，哥们。"
    },
    {
     "who": "You",
     "t": "Ya le avisé a la oficina. Espera un rato.",
     "zh": "我已经通知办公室了。等一会儿。"
    },
    {
     "who": "Driver",
     "t": "Está bien, gracias.",
     "zh": "好吧，谢谢。"
    }
   ],
   "phrases": [
    {
     "t": "El contenedor está dañado.",
     "zh": "柜子损坏了。"
    },
    {
     "t": "Tiene un hoyo en el techo.",
     "zh": "顶上有个洞。",
     "note": "hoyo = 洞，墨西哥常用；也说 agujero。"
    },
    {
     "t": "La puerta no cierra bien.",
     "zh": "门关不严。"
    },
    {
     "t": "Se rompió el candado.",
     "zh": "锁坏了。"
    },
    {
     "t": "Falta el sello.",
     "zh": "封条没了。"
    },
    {
     "t": "El número del sello no coincide.",
     "zh": "封条号对不上。"
    },
    {
     "t": "La llanta está ponchada.",
     "zh": "轮胎扎了。",
     "note": "ponchada = 漏气/爆胎，墨西哥说法（来自 punch）。"
    },
    {
     "t": "El chasis tiene una luz fundida.",
     "zh": "车架有个灯坏了。",
     "note": "fundida = 灯泡烧了。"
    },
    {
     "t": "Está goteando algo abajo.",
     "zh": "下面在滴东西。"
    },
    {
     "t": "Hay que tomarle fotos.",
     "zh": "得拍照。"
    },
    {
     "t": "Llama al supervisor, por favor.",
     "zh": "请叫主管。"
    },
    {
     "t": "No lo muevas todavía.",
     "zh": "先别动它。"
    },
    {
     "t": "El sistema no me deja.",
     "zh": "系统不让我操作。"
    },
    {
     "t": "Este contenedor no está en la lista.",
     "zh": "这个柜子不在单子上。"
    },
    {
     "t": "Tus papeles no están completos.",
     "zh": "你的单据不全。"
    },
    {
     "t": "Tienes que esperar un rato.",
     "zh": "你得等一会儿。"
    },
    {
     "t": "Ya le avisé a la oficina.",
     "zh": "我已经通知办公室了。"
    },
    {
     "t": "No te preocupes, lo vamos a arreglar.",
     "zh": "别担心，我们会处理好的。"
    }
   ]
  },
  {
   "id": "es-platica",
   "name": "闲聊",
   "icon": "⚽",
   "group": "西语",
   "lang": "es-MX",
   "intro": "等车、休息时聊足球、吃的、家人和天气。Upland 夏天很热，聊 el calor 永远不会冷场。",
   "dialog": [
    {
     "who": "Coworker",
     "t": "¿Viste el partido ayer?",
     "zh": "你看昨天的比赛了吗？"
    },
    {
     "who": "You",
     "t": "No, ¿quién ganó?",
     "zh": "没看，谁赢了？"
    },
    {
     "who": "Coworker",
     "t": "Ganó el América, dos a uno.",
     "zh": "美洲队赢了，二比一。"
    },
    {
     "who": "You",
     "t": "¡Órale! ¿Le vas al América?",
     "zh": "哇！你支持美洲队？"
    },
    {
     "who": "Coworker",
     "t": "Siempre. ¿Y tú, de dónde eres?",
     "zh": "一直支持。你是哪里人？"
    },
    {
     "who": "You",
     "t": "Soy de China. Estoy aprendiendo español.",
     "zh": "我是中国人。我在学西语。"
    },
    {
     "who": "Coworker",
     "t": "¡Qué padre! Hablas bien.",
     "zh": "太棒了！你说得挺好。"
    },
    {
     "who": "You",
     "t": "Gracias. ¡Qué calor hace hoy!",
     "zh": "谢谢。今天真热啊！"
    }
   ],
   "phrases": [
    {
     "t": "¿Viste el partido ayer?",
     "zh": "你看昨天的比赛了吗？"
    },
    {
     "t": "¿Le vas al América o a las Chivas?",
     "zh": "你支持美洲队还是瓜达拉哈拉队？",
     "note": "irle a un equipo = 支持某队，墨西哥说法；这两队是墨西哥最大的宿敌。"
    },
    {
     "t": "Yo le voy al Galaxy.",
     "zh": "我支持银河队。"
    },
    {
     "t": "¡Qué calor hace hoy!",
     "zh": "今天真热啊！"
    },
    {
     "t": "Toma mucha agua, está pesado el sol.",
     "zh": "多喝水，太阳很毒。",
     "note": "pesado = 厉害、受不了，口语。"
    },
    {
     "t": "¿Qué hiciste el fin de semana?",
     "zh": "你周末干嘛了？"
    },
    {
     "t": "Fui a una carne asada con la familia.",
     "zh": "我跟家人去烤肉了。",
     "note": "carne asada 在墨西哥裔家庭也指周末烤肉聚会。"
    },
    {
     "t": "¿Tienes hijos?",
     "zh": "你有孩子吗？"
    },
    {
     "t": "Sí, tengo dos, un niño y una niña.",
     "zh": "有，两个，一男一女。"
    },
    {
     "t": "¿De qué parte de México eres?",
     "zh": "你是墨西哥哪里人？"
    },
    {
     "t": "Yo soy de China.",
     "zh": "我是中国人，广东的。",
     "note": "地名可以换成你的家乡。"
    },
    {
     "t": "Estoy aprendiendo español.",
     "zh": "我在学西班牙语。"
    },
    {
     "t": "¿Cómo se dice esto en español?",
     "zh": "这个用西语怎么说？"
    },
    {
     "t": "¿Dónde venden buenos tacos por aquí?",
     "zh": "这附近哪儿的塔可好吃？"
    },
    {
     "t": "Te invito un café.",
     "zh": "我请你喝咖啡。"
    },
    {
     "t": "¡No manches, qué bueno!",
     "zh": "不是吧，太好了！",
     "note": "No manches = 不会吧/真的假的，墨西哥口语，比较随意但干净。"
    },
    {
     "t": "Está chido.",
     "zh": "挺酷的/挺好的。",
     "note": "chido = 酷、好，墨西哥俚语。"
    },
    {
     "t": "¡Órale, qué padre!",
     "zh": "哇，太棒了！",
     "note": "padre 在墨西哥口语中表示“很棒”。"
    }
   ]
  }
 ]
}