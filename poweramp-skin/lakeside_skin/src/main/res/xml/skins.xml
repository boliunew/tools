<?xml version="1.0" encoding="utf-8"?>
<!-- 湖光 Lakeside skin. Based on Poweramp v3 Skin SDK sample. -->
<skins targetBuild="1003">
	<skin
		name="@string/lake_skin_name"
		author="@string/lake_skin_author"
		description="@string/lake_skin_desc"
		style="@style/LakeSkin"
		forceGlobalOptions="true"
		allowNewPadding="true"
	>
		<!--BG_OPTIONS_START-->
		<radio key="lake_bg" name="@string/lake_opt_bg" summary="@string/lake_opt_bg_sum" defaultValue="">
			<option name="@string/lake_bg_name_1" overlapStyle=""/>
		</radio>
		<!--BG_OPTIONS_END-->
		<option
			key="lake_system_font"
			name="@string/lake_opt_font"
			summary="@string/lake_opt_font_sum"
			overlapStyle="@style/LakeSkin_SystemFont"
			checkedByDefault="false"
		/>
		<option
			key="lake_aa_blur"
			name="@string/lake_opt_aablur"
			summary="@string/lake_opt_aablur_sum"
			overlapStyle="@style/LakeSkin_AABlur"
			checkedByDefault="false"
		/>
	</skin>
</skins>
