<?xml version="1.0" encoding="utf-8"?>
<!--suppress ALL -->
<resources xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
	tools:ignore="ResourceCycle, NewApi">

	<!-- 湖光 Lakeside: Poweramp dark theme + 霞鹜文楷 (via LakeSkin_FontBase) + photo background + lake/sky palette -->
	<style name="LakeSkin" parent="LakeSkin_FontBase">
		<!-- Photo background on the full-screen list layer and on the equalizer page. Photo 1 by default,
		     other photos come from the 底图 option (values/lake_bg_gen.xml) -->
		<item name="com.maxmpz.audioplayer:TopListWidget">@style/LakeSkin_TopListWidget_1</item>
		<item name="com.maxmpz.audioplayer:TopEqLayout">@style/LakeSkin_TopEqLayout_1</item>

		<!-- Dark glass strip behind the small buttons under the album art -->
		<item name="com.maxmpz.audioplayer:TopSubAAButtons">@style/LakeSkin_TopSubAAButtons</item>

		<!-- Let the photo show under the status bar -->
		<item name="com.maxmpz.audioplayer:statusBarBg">#2000</item>

		<!-- Brighter secondary text so it stays readable over bright sky -->
		<item name="android:textColorSecondary">#C9D6E4</item>
		<item name="android:textColorTertiary">#B4C3D3</item>
		<item name="com.maxmpz.audioplayer:colorTrackMeta">#BFD0E2</item>
		<item name="com.maxmpz.audioplayer:colorTrackNum">#BFD0E2</item>
		<item name="com.maxmpz.audioplayer:colorMetaInfo">#D6E3F0</item>

		<!-- Palette taken from the photo: sky blue, deep lake navy, sunlit shore gold -->
		<item name="com.maxmpz.audioplayer:colorAABgColor">#0E1824</item>
		<item name="com.maxmpz.audioplayer:colorBgPrimary">#1B2735</item>
		<item name="com.maxmpz.audioplayer:colorBgPrimaryStrictAlpha">#F01B2735</item>
		<item name="com.maxmpz.audioplayer:colorBgLight">#2A3A4D</item>
		<item name="com.maxmpz.audioplayer:colorBgCheckedLight">#35506B</item>
		<item name="com.maxmpz.audioplayer:colorBgNavbar">#D914202E</item>
		<item name="com.maxmpz.audioplayer:colorBgTransparentNavbar">#8814202E</item>
		<item name="com.maxmpz.audioplayer:colorItemPlayingMark">#663A6EA5</item>
		<item name="com.maxmpz.audioplayer:colorSeekbarProgress">#8CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorWaveseekTint">#8CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorFrs">#8CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorFrsTone">#B38CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorKnobIndicator">#8CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorRating">#FFD27A</item>
		<item name="com.maxmpz.audioplayer:colorFastScroller">#8CC4FF</item>
		<item name="com.maxmpz.audioplayer:colorAZBg">#A014202E</item>
		<item name="com.maxmpz.audioplayer:colorScrollPopupBg">#C03A6EA5</item>
	</style>

	<style name="LakeSkin_TopSubAAButtons" parent="com.maxmpz.audioplayer:TopSubAAButtons">
		<item name="android:background">@drawable/lake_pill_bg</item>
	</style>

	<!-- Option: back to Poweramp's stock album-art blur (no photo) -->
	<style name="LakeSkin_AABlur">
		<item name="com.maxmpz.audioplayer:TopListWidget">@com.maxmpz.audioplayer:style/TopListWidget</item>
		<item name="com.maxmpz.audioplayer:TopEqLayout">@com.maxmpz.audioplayer:style/TopEqLayout</item>
	</style>
</resources>
